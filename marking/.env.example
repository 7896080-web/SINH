# Пример .env программы маркировки. install_marking.ps1 создаёт его сам со
# СВОИМИ секретами (не ключами sync_admin).
DATABASE_URL=sqlite:///C:/marking/marking.db
MARKING_SECRETS_KEY=
MARKING_SESSION_SECRET=
MARKING_ONEC_TASKS_DIR=C:\sync\tasks
MARKING_ONEC_RESULTS_DIR=C:\sync\results\marking
MARKING_ONEC_ARCHIVE_DIR=C:\sync\archive\marking
MARKING_BACKUP_DIR=C:\marking\backups
MARKING_RCLONE_EXE=C:\marking\tools\rclone.exe
MARKING_RCLONE_CONFIG=C:\marking\rclone.conf
# Пусто — облако выключено. Например: yandex:marking_backups
MARKING_RCLONE_REMOTE=
