# Пример .env программы маркировки на РАБОЧЕМ КОМПЬЮТЕРЕ с КриптоПро.
# install_workstation.ps1 создаёт его сам со СВОИМИ секретами — руками его
# заполнять не нужно; этот файл — справка, что в нём и зачем.
DATABASE_URL=sqlite:///C:/marking/marking.db
# Ключ шифрования секретов в базе (API-ключ НК, с этапа 4 — токены ЧЗ).
# Хранить отдельно от копий базы, НЕ на Яндекс.Диске.
MARKING_SECRETS_KEY=
MARKING_SESSION_SECRET=
# Обмен с 1С — SFTP до C:\sync сервера (deploy/SFTP_1C.md). Пустой хост —
# локальные папки (MARKING_ONEC_TASKS_DIR/RESULTS_DIR, вариант «на сервере»).
MARKING_ONEC_SFTP_HOST=136.243.92.95
MARKING_ONEC_SFTP_PORT=443
MARKING_ONEC_SFTP_USER=marking_sftp
MARKING_ONEC_SFTP_KEY=C:\marking\ssh\id_ed25519
MARKING_ONEC_SFTP_KNOWN_HOSTS=C:\marking\ssh\known_hosts
# Копия разобранных ответов 1С у себя (на сервере они уходят в archive\marking).
MARKING_ONEC_ARCHIVE_DIR=C:\marking\onec_archive
MARKING_BACKUP_DIR=C:\marking\backups
MARKING_RCLONE_EXE=C:\marking\tools\rclone.exe
MARKING_RCLONE_CONFIG=C:\marking\rclone.conf
# Пусто — облако выключено. Например: yandex:marking_backups
MARKING_RCLONE_REMOTE=
# Фоновая работа (1С по факту, НК, копия) — в процессе программы. 0 — только
# для варианта «на сервере», где её делает служба marking_worker.
# MARKING_BACKGROUND=1

# Склады 1С — КОДЫ справочника «Склады» (не наименования). Умолчания — боевая база:
# MARKING_WAREHOUSE_FROM_CODE=ЦБ0000012   # ЦС Склад
# MARKING_WAREHOUSE_TO_CODE=ЦБ0000017     # Lamaoda_Склад
