# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=
# Кому бот отвечает — Telegram id через запятую (свой id бот покажет в ответ на любое сообщение)
ALLOWED_USER_IDS=
# Где лежат база и сохранённые скриншоты
FINANCE_DATA_DIR=/opt/finance-bot/data
# Часовой пояс: от него зависит «сегодня» и «вчера»
TZ=Europe/Moscow
