# AWER Forecast — скопируйте в .env и заполните. .env в репозиторий не коммитится.

# --- База ---
# Прод по ТЗ — PostgreSQL:
#   FORECAST_DATABASE_URL=postgresql+psycopg://forecast:ПАРОЛЬ@localhost:5432/forecast
# Без PostgreSQL (как Sync Admin на Windows-сервере) — SQLite-файл:
FORECAST_DATABASE_URL=sqlite:///C:/awer_forecast/forecast.db

# --- Вход на страницы ---
# Случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
FORECAST_SESSION_SECRET=
FORECAST_LOGIN=admin
# Хеш пароля: python -m forecast set-password
FORECAST_PASSWORD_HASH=

# --- Lamoda Seller Partner API v2 ---
# Нужны все три. 403 чаще всего = sellerId не от этих ключей.
LAMODA_BASE_URL=https://public-api-seller.lamoda.ru/api
LAMODA_CLIENT_ID=
LAMODA_CLIENT_SECRET=
LAMODA_SELLER_ID=
LAMODA_COUNTRY=RU
# Первый опрос заказов берёт историю за столько дней; дальше — от прошлого запуска с перекрытием.
LAMODA_ORDERS_BACKFILL_DAYS=180
LAMODA_ORDERS_OVERLAP_HOURS=6

# --- 1С (FTP-мост Sync Admin) ---
# Где искать stock_*.txt: файлы только читаются, НЕ переносятся (их забирает Sync Admin).
ONEC_EXCHANGE_DIRS=C:\sync\results;C:\sync\archive
# Каталог с файлами продаж sales_*.txt (формат — README, «Вопросы по 1С»). Пусто — шаг пропускается.
ONEC_SALES_DIR=

# --- Параметры расчёта (раздел 5.5 ТЗ) ---
PLAN_SERVICE_LEVEL_Z=1.65
PLAN_REVIEW_INTERVAL_DAYS=7
PLAN_FBO_LEAD_DAYS=7
PLAN_SUPPLIER_LEAD_DAYS=60
PLAN_HISTORY_DAYS=180
PLAN_MIN_HISTORY_DAYS=14
PLAN_FORECAST_HORIZON_DAYS=28
PLAN_OUTLIER_SIGMA=3.0
# Пусто — α подбирается по истории каждого размера
PLAN_SMOOTHING_ALPHA=
# Сколько штук каждого размера не отгружать с ЦС на FBO (оставить для WB/Ozon/сайта)
PLAN_CS_RESERVE_QTY=0
PLAN_PURCHASE_GRACE_DAYS=14
# Статусы поставки Lamoda, в которых её товар ещё НЕ списан с ЦС в 1С (списывают после создания
# поставки). Пусто — по умолчанию: всё до прибытия на склад Lamoda.
# PLAN_FBO_STATUSES_ON_CS=DRAFT,NEW,SENT,VALIDATION,VALIDATION_ERROR,CONFIRMED,READY_FOR_SHIPMENT,CHANGING_WAREHOUSE
