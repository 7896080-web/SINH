# Программа «Финансы площадок» — образец .env. На сервере его пишет
# deploy\install_server.ps1 сам (ключи генерирует), руками править не нужно.
DATABASE_URL=sqlite:///C:/mpfinance/mpfinance.db
# Свой ключ шифрования ключей площадок — НЕ ключ sync_admin и не «Репрайсера».
MPFIN_SECRETS_KEY=
MPFIN_SESSION_SECRET=
# Обмен с 1С: общая папка заданий, свои подкаталоги ответов и архива.
MPFIN_ONEC_TASKS_DIR=C:\sync\tasks
MPFIN_ONEC_RESULTS_DIR=C:\sync\results\finance
MPFIN_ONEC_ARCHIVE_DIR=C:\sync\archive\finance
# База sync_admin — только чтение (мэппинг баркодов, заказы для сверки).
MPFIN_SYNC_DB=C:\sync_admin\sync_admin.db
MPFIN_BACKUP_DIR=C:\mpfinance\backups
