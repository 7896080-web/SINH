# Скопируйте в .env (рядом с config.yaml). Файл .env не коммитить.
MAX_BOT_TOKEN=            # токен бота MAX (выдаётся при создании бота на платформе MAX для партнёров)
ADMIN_PASSWORD=           # пароль админки (логин admin)
UPLOAD_TOKEN=             # токен для приёма выгрузки 1С по HTTP (/api/upload); тот же — в обработке 1С
ANTHROPIC_API_KEY=        # необязательно: переформулировка советов (recommendations.llm: true)
