// Модуль ОБЫЧНОЙ формы «Форма» обработки ВыгрузкаПродажДляБота.
// Реквизиты обработки: ДатаНачала (Дата), ДатаОкончания (Дата), КаталогВыгрузки (Строка),
//   Источник (Строка: «Чеки» или «ОРП»), СкладыМагазинов (Строка, подстроки через «;», напр. «ГОРОД;МСЛ»).
// На форме: поля этих реквизитов и кнопка «Выгрузить» (действие — КнопкаВыгрузитьНажатие).
//
// Автозапуск без участия человека (Планировщик заданий Windows):
//   "C:\Program Files\1cv8\<версия>\bin\1cv8.exe" ENTERPRISE /F"D:\Base" /N"Бот" /P"пароль"
//      /Execute"C:\awer-sales-bot\onec\ВыгрузкаПродажДляБота.epf" /C"АВТО" /DisableStartupMessages
// При параметре /C"АВТО" форма выгружает вчера+позавчера и закрывает 1С.

Перем КаталогПоУмолчанию;

Процедура ПриОткрытии()

	КаталогПоУмолчанию = "C:\awer-sales-bot\data\inbox"; // ЗАМЕНИТЬ на свою папку (можно сетевую \\server\awer-inbox)
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоДня(ТекущаяДата()) - 86400;
		ДатаОкончания = ДатаНачала;
	КонецЕсли;
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		КаталогВыгрузки = КаталогПоУмолчанию;
	КонецЕсли;
	Если ПустаяСтрока(Источник) Тогда
		Источник = "Чеки"; // ЗАМЕНИТЬ на "ОРП", если чеки в базе не хранятся
	КонецЕсли;
	Если ПустаяСтрока(СкладыМагазинов) Тогда
		СкладыМагазинов = "ГОРОД;МСЛ"; // ПРОВЕРИТЬ названия складов магазинов
	КонецЕсли;

	Если ВРег(СокрЛП(ПараметрЗапуска)) = "АВТО" Тогда
		Попытка
			ВыгрузитьЗаПоследниеДни(КаталогВыгрузки, Источник, СкладыМагазинов, 2);
		Исключение
			ЗаписьЖурналаРегистрации("ВыгрузкаПродажДляБота", УровеньЖурналаРегистрации.Ошибка, , ,
				ОписаниеОшибки());
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура КнопкаВыгрузитьНажатие(Кнопка)

	Если ДатаОкончания < ДатаНачала Тогда
		Предупреждение("Дата окончания раньше даты начала");
		Возврат;
	КонецЕсли;
	Файлы = Выгрузить(ДатаНачала, ДатаОкончания, КаталогВыгрузки, Источник, СкладыМагазинов);
	Сообщить("Готово: " + СтрСоединитьФайлы(Файлы));

КонецПроцедуры

Функция СтрСоединитьФайлы(Файлы)
	Результат = "";
	Для Каждого Ф Из Файлы Цикл
		Результат = Результат + ?(Результат = "", "", ", ") + Ф;
	КонецЦикла;
	Возврат Результат;
КонецФункции
