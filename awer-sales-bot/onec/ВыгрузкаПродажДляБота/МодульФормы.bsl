// Модуль ОБЫЧНОЙ формы «Форма» обработки ВыгрузкаПродажДляБота (основная форма).
// Полей и кнопок на форме не нужно — всё спрашивается окнами. Как в обработке Sync Admin «ОбменССайтом»
// (проверено на этом сервере, 8.3.9.2233): обработчик ПриОткрытии ПРИВЯЗАТЬ В ПАЛИТРЕ СВОЙСТВ формы
// (События → ПриОткрытии) — сам по имени процедуры он не подключается.
//
// Автозапуск (задачу Планировщика создаёт scripts\install-1c-task.ps1; нужна интерактивная сессия Windows):
//   "C:\Program Files\1cv8\8.3.9.2233\bin\1cv8.exe" ENTERPRISE /S"<сервер>\<база>" /WA+
//      /Execute"C:\awer-sales-bot\onec\ВыгрузкаПродажДляБота.epf" /CAUTO /DisableStartupDialogs /DisableStartupMessages
// /CAUTO — выгрузить вчера и позавчера и закрыть 1С; /CCHECK — отчёт «Проверка базы» и закрыть 1С.
// Параметр латиницей и без кавычек, как /CEXCHANGE у Sync Admin. Ошибка — в журнал регистрации и файлом
// error_*.txt в папку бота: бот перешлёт её владельцу.

Перем ПапкаДляБота;      // папка входящих бота
Перем ИсточникПродаж;    // "Чеки" или "ОРП"
Перем ПодстрокиСкладов;  // подстроки названий складов магазинов через ";"

Процедура ПриОткрытии()

	ПапкаДляБота = "C:\awer-sales-bot\data\inbox"; // ЗАМЕНИТЬ, если бот в другой папке (можно сетевую \\server\awer-inbox)
	ИсточникПродаж = "Чеки";                       // "ОРП", если чеки после закрытия смены в базе не хранятся
	ПодстрокиСкладов = "ГОРОД;МСЛ";                // ПРОВЕРИТЬ по отчёту «Проверить базу»: склады магазинов

	Режим = ВРег(СокрЛП(ПараметрЗапуска));
	Если Режим = "AUTO" Или Режим = "АВТО" Тогда
		Попытка
			ВыгрузитьЗаПоследниеДни(ПапкаДляБота, ИсточникПродаж, ПодстрокиСкладов, 2);
		Исключение
			ЗаписатьОшибку(ПапкаДляБота, "auto", ОписаниеОшибки());
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	ИначеЕсли Режим = "CHECK" Тогда
		Попытка
			ПроверитьБазу(ПапкаДляБота, ПодстрокиСкладов);
		Исключение
			ЗаписатьОшибку(ПапкаДляБота, "check", ОписаниеОшибки());
		КонецПопытки;
		ЗавершитьРаботуСистемы(Ложь);
	Иначе
		РучнойЗапуск();
		Попытка
			Закрыть(); // пустую форму на экране не оставляем
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Процедура РучнойЗапуск()
	Папка = Новый Файл(ПапкаДляБота);
	Если Не Папка.Существует() Тогда
		Предупреждение("Папка для бота не найдена: " + ПапкаДляБота + Символы.ПС
			+ "Исправьте ПапкаДляБота в модуле формы (процедура ПриОткрытии) и сохраните обработку заново.");
		Возврат;
	КонецЕсли;
	Действия = Новый СписокЗначений;
	Действия.Добавить("export", "Выгрузить продажи за период");
	Действия.Добавить("check", "Проверить базу (для настройки обработки)");
	Выбор = Действия.ВыбратьЭлемент("Выгрузка продаж для бота", Действия[0]);
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Выбор.Значение = "check" Тогда
		Состояние("Проверка базы…");
		Имя = ПроверитьБазу(ПапкаДляБота, ПодстрокиСкладов);
		Предупреждение("Готово: " + Имя + Символы.ПС + "Пришлите текст этого файла разработчику бота.");
		Попытка
			ЗапуститьПриложение(Имя);
		Исключение
		КонецПопытки;
		Возврат;
	КонецЕсли;
	Начало = НачалоДня(ТекущаяДата()) - 86400;
	Окончание = Начало;
	Если Не ВвестиДату(Начало, "Выгрузить продажи С (первый день)", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	Если Не ВвестиДату(Окончание, "ПО (последний день; для истории — целые месяцы)", ЧастиДаты.Дата) Тогда
		Возврат;
	КонецЕсли;
	Если Окончание < Начало Тогда
		Предупреждение("Последний день раньше первого — выгрузка не сделана.");
		Возврат;
	КонецЕсли;
	Источники = Новый СписокЗначений;
	Источники.Добавить("Чеки", "Чеки ККМ — номер чека и время (лучше)");
	Источники.Добавить("ОРП", "Отчёты о розничных продажах — если чеков за этот период в базе нет");
	Ист = Источники.ВыбратьЭлемент("Откуда брать продажи", Источники.НайтиПоЗначению(ИсточникПродаж));
	Если Ист = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Состояние("Выгрузка продаж за " + Формат(Начало, "ДФ=dd.MM.yyyy") + " – " + Формат(Окончание, "ДФ=dd.MM.yyyy") + "…");
	Файлы = Выгрузить(Начало, Окончание, ПапкаДляБота, Ист.Значение, ПодстрокиСкладов);
	Список = "";
	Для Каждого Ф Из Файлы Цикл
		Список = Список + Символы.ПС + Ф;
	КонецЦикла;
	Предупреждение("Выгружено файлов: " + Файлы.Количество() + " из 4" + Список
		+ ?(Файлы.Количество() < 4, Символы.ПС + "Чего нет — причина в файле error_*.txt в той же папке.", ""));
КонецПроцедуры
