// Модуль управляемой формы «Форма» обработки ВыгрузкаПродажДляБота.
// Реквизиты формы (основной реквизит «Объект» — ВнешняяОбработкаОбъект.ВыгрузкаПродажДляБота):
//   Объект.ДатаНачала (Дата), Объект.ДатаОкончания (Дата), Объект.КаталогВыгрузки (Строка),
//   Объект.АдресСервиса (Строка), Объект.ТокенСервиса (Строка), Объект.ТолькоЗакрытыеСмены (Булево).
// Команда формы «Выгрузить» → обработчик Выгрузить.

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		Объект.ДатаНачала = НачалоДня(ТекущаяДата()) - 86400;
		Объект.ДатаОкончания = Объект.ДатаНачала;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КаталогВыгрузки) Тогда
		Объект.КаталогВыгрузки = "C:\awer-sales-bot\data\inbox";
	КонецЕсли;
	Объект.ТолькоЗакрытыеСмены = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	Если Объект.ДатаОкончания < Объект.ДатаНачала Тогда
		Сообщить("Дата окончания раньше даты начала");
		Возврат;
	КонецЕсли;
	ИмяФайла = ВыгрузитьНаСервере();
	ПоказатьОповещениеПользователя("Выгрузка готова", , ИмяФайла);
КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.Выгрузить(Объект.ДатаНачала, Объект.ДатаОкончания, Объект.КаталогВыгрузки,
		Объект.АдресСервиса, Объект.ТокенСервиса, Объект.ТолькоЗакрытыеСмены);
КонецФункции
