// ============================================================================
// Внешняя обработка «Выгрузка продаж для бота» (ВыгрузкаПродажДляБота.epf)
// Обычное приложение (обычные формы). Источник — документы «Отчет о розничных продажах» (ОРП).
//
// Создаёт два файла в папке «входящие» бота:
//   orp_lines_ГГГГММДД_ГГГГММДД.csv — строки ОРП (продажи и возвраты) по продавцам:
//       Дата;Склад;Документ;Продавец;Номенклатура;Номенклатурная группа;Количество;Сумма;Скидка
//   orp_docs_ГГГГММДД_ГГГГММДД.csv  — шапки ОРП (средний чек и вещей в чеке по магазину):
//       Дата;Магазин;Касса;Документ;Чеков;Чеков возврата;Выручка
//
// !!! ПРОВЕРИТЬ В КОНФИГУРАТОРЕ имена реквизитов (места помечены «ПРОВЕРИТЬ»).
//     По форме документа видно: шапка — «Касса (ККМ)», «Количество чеков», «Количество чеков возврата»;
//     ТЧ «Товары» — Номенклатура, Количество, Цена, Сумма, Продавец, Склад; вкладка «Возвращенные товары».
// ============================================================================

// Основная процедура. Возвращает массив имён созданных файлов.
//   ДатаНачала, ДатаОкончания — период (включительно)
//   КаталогВыгрузки          — папка «входящие» бота, например C:\awer-sales-bot\data\inbox или \\server\awer-inbox
Функция Выгрузить(ДатаНачала, ДатаОкончания, КаталогВыгрузки) Экспорт

	Начало = НачалоДня(ДатаНачала);
	Окончание = КонецДня(ДатаОкончания);
	Суффикс = Формат(Начало, "ДФ=yyyyMMdd") + "_" + Формат(Окончание, "ДФ=yyyyMMdd");
	Каталог = ДобавитьРазделитель(КаталогВыгрузки);

	Файлы = Новый Массив;
	// сначала шапки, потом строки — бот импортирует в этом порядке
	ИмяШапок = Каталог + "orp_docs_" + Суффикс + ".csv";
	ЗаписатьШапки(ПолучитьШапки(Начало, Окончание), ИмяШапок);
	Файлы.Добавить(ИмяШапок);

	ИмяСтрок = Каталог + "orp_lines_" + Суффикс + ".csv";
	ЗаписатьСтроки(ПолучитьСтроки(Начало, Окончание), ИмяСтрок);
	Файлы.Добавить(ИмяСтрок);

	Возврат Файлы;

КонецФункции

// Для автозапуска: вчера и позавчера (повтор безопасен — бот заменяет данные дня целиком).
Функция ВыгрузитьЗаПоследниеДни(КаталогВыгрузки, ДнейНазад = 2) Экспорт
	Вчера = НачалоДня(ТекущаяДата()) - 86400;
	Возврат Выгрузить(Вчера - 86400 * (ДнейНазад - 1), Вчера, КаталогВыгрузки);
КонецФункции

// ----------------------------------------------------------------------------
Функция ПолучитьСтроки(Начало, Окончание)

	Запрос = Новый Запрос;
	// ПРОВЕРИТЬ: Документ.ОтчетОРозничныхПродажах; ТЧ «Товары» и «ВозвращенныеТовары»;
	//            колонка «Продавец» в ТЧ; «Склад» в ТЧ; Номенклатура.НоменклатурнаяГруппа.
	//            Скидка считается как Цена × Количество − Сумма (не зависит от названий колонок скидок).
	//            Если в «Возвращенных товарах» нет колонки «Продавец» — замените в 2-й части на ""Без продавца""
	//            или на продавца из связанного чека.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК Склад,
	|	Т.Ссылка.Номер КАК Документ,
	|	ПРЕДСТАВЛЕНИЕ(Т.Продавец) КАК Продавец,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	Т.Количество КАК Количество,
	|	Т.Сумма КАК Сумма,
	|	Т.Цена * Т.Количество - Т.Сумма КАК Скидка
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И Т.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(В.Ссылка.Дата, ДЕНЬ),
	|	ПРЕДСТАВЛЕНИЕ(В.Склад),
	|	В.Ссылка.Номер,
	|	ПРЕДСТАВЛЕНИЕ(В.Продавец),
	|	ПРЕДСТАВЛЕНИЕ(В.Номенклатура),
	|	ПРЕДСТАВЛЕНИЕ(В.Номенклатура.НоменклатурнаяГруппа),
	|	-В.Количество,
	|	-В.Сумма,
	|	0
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.ВозвращенныеТовары КАК В
	|ГДЕ
	|	В.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И В.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьШапки(Начало, Окончание)

	Запрос = Новый Запрос;
	// ПРОВЕРИТЬ: реквизиты шапки «КассаККМ», «КоличествоЧеков», «КоличествоЧековВозврата».
	// Магазин берётся из названия кассы («P1 Город_Касса_Основная») — в боте config.yaml → onec.store_map.
	// Выручка = сумма строк «Товары» (как поле «Выручка» внизу формы).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Д.КассаККМ) КАК Касса,
	|	Д.Номер КАК Документ,
	|	Д.КоличествоЧеков КАК Чеков,
	|	Д.КоличествоЧековВозврата КАК ЧековВозврата,
	|	ЕСТЬNULL(СУММА(Т.Сумма), 0) КАК Выручка
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах.Товары КАК Т
	|		ПО Т.Ссылка = Д.Ссылка
	|ГДЕ
	|	Д.Дата МЕЖДУ &Начало И &Окончание
	|	И Д.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ),
	|	ПРЕДСТАВЛЕНИЕ(Д.КассаККМ),
	|	Д.Номер,
	|	Д.КоличествоЧеков,
	|	Д.КоличествоЧековВозврата";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// ----------------------------------------------------------------------------
Процедура ЗаписатьСтроки(Таблица, ИмяФайла)
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Дата;Склад;Документ;Продавец;Номенклатура;Номенклатурная группа;Количество;Сумма;Скидка");
	Для Каждого С Из Таблица Цикл
		Запись.ЗаписатьСтроку(Формат(С.Дата, "ДФ=dd.MM.yyyy") + ";" + Очистить(С.Склад) + ";" + Очистить(С.Документ)
			+ ";" + Очистить(С.Продавец) + ";" + Очистить(С.Номенклатура) + ";" + Очистить(С.Группа)
			+ ";" + Число_(С.Количество) + ";" + Число_(С.Сумма) + ";" + Число_(С.Скидка));
	КонецЦикла;
	Запись.Закрыть();
КонецПроцедуры

Процедура ЗаписатьШапки(Таблица, ИмяФайла)
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Дата;Магазин;Касса;Документ;Чеков;Чеков возврата;Выручка");
	Для Каждого С Из Таблица Цикл
		Запись.ЗаписатьСтроку(Формат(С.Дата, "ДФ=dd.MM.yyyy") + ";" + Очистить(С.Касса) + ";" + Очистить(С.Касса)
			+ ";" + Очистить(С.Документ) + ";" + Число_(С.Чеков) + ";" + Число_(С.ЧековВозврата)
			+ ";" + Число_(С.Выручка));
	КонецЦикла;
	Запись.Закрыть();
КонецПроцедуры

Функция Число_(Значение)
	Возврат Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");
КонецФункции

Функция Очистить(Значение)
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Значение)), ";", ","), Символы.ПС, " ");
КонецФункции

Функция ДобавитьРазделитель(Каталог)
	Если Прав(Каталог, 1) = "\" Или Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат Каталог + "\";
КонецФункции
