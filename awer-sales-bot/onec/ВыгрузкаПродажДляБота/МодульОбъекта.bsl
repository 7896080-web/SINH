// ============================================================================
// Внешняя обработка «Выгрузка продаж для бота» (ВыгрузкаПродажДляБота.epf). Обычное приложение.
//
// Файлы в папку «входящие» бота за период:
//   sales_*.csv    — строки продаж по продавцам. Источник: ЧЕКИ ККМ (если хранятся — информативнее:
//                    номер чека, время → средний чек и вещей в чеке по каждому продавцу) или ОРП (сводно).
//       Дата;Время;Склад;Документ;Чек;Продавец;Номенклатура;Номенклатурная группа;Количество;Цена;Сумма;Скидка;
//       Ручная скидка %;Дисконтная карта
//   orp_docs_*.csv — шапки «Отчетов о розничных продажах» (чеков, выручка) — для среднего чека магазина
//                    и как признак «смена закрыта».
//   stock_*.csv    — остатки на складах магазинов на конец периода.
//   arrivals_*.csv — поступления на склады магазинов за период.
//
//   error_*.txt    — если раздел не выгрузился: текст ошибки. Бот пересылает его владельцу (иначе ошибка
//                    осталась бы только в журнале регистрации 1С, а бот увидел бы лишь «нет выгрузки»).
//
// Каждый файл пишется во временный *.part и переименовывается — бот не прочитает недописанный файл.
// Разделы выгружаются независимо: ошибка в одном не останавливает остальные.
//
// Имена документов и реквизитов сверены отчётом «Проверка базы» 19.10.2026 (8.3.9.2233, «NEW Магазин одежды и
// обуви» 1.0.16.1): склад — в строке чека (Товары.Склад), продавец — в строке (Товары.Продавец) и в шапке,
// чеков в ОРП — hiКоличествоЧеков / hiКоличествоЧековВозврата, бренд — Номенклатура.Бренд, цвет — hiЦвет.
// В языке запросов «В» — служебное слово (В списке): таблицам такой псевдоним не давать.
// ПРЕДСТАВЛЕНИЕ() — только в списке полей: в выражениях, условиях и группировке язык запросов его не допускает.
//
// Запуск — из обычной формы (МодульФормы.bsl, обработчик ПриОткрытии привязан в палитре свойств), как в обработке
// Sync Admin «ОбменССайтом», проверенной на этом же сервере (8.3.9.2233):
//   /CAUTO  — выгрузить вчера и позавчера и закрыть 1С (задача Планировщика, scripts/install-1c-task.ps1);
//   /CCHECK — записать отчёт «Проверка базы» (check_*.txt) и закрыть 1С;
//   без параметра (Файл → Открыть) — спросить: выгрузить за период или проверить базу.
// В этом модуле только серверный и общий код — окна вопросов в модуле формы.
// ============================================================================

// Источник: "Чеки" или "ОРП". Склады магазинов — подстроки названий через ";" ("ГОРОД_склад;МСЛ_Склад":
// просто «ГОРОД» захватит и склад «ГОРОД_в пути»).
Функция Выгрузить(ДатаНачала, ДатаОкончания, КаталогВыгрузки, Источник = "Чеки", СкладыМагазинов = "ГОРОД_склад;МСЛ_Склад") Экспорт

	Начало = НачалоДня(ДатаНачала);
	Окончание = КонецДня(ДатаОкончания);
	Суффикс = Формат(Начало, "ДФ=yyyyMMdd") + "_" + Формат(Окончание, "ДФ=yyyyMMdd");
	Каталог = ДобавитьРазделитель(КаталогВыгрузки);
	Склады = РазложитьСтроку(СкладыМагазинов);
	СкладыСсылки = НайтиСклады(Склады);
	Файлы = Новый Массив;

	// 1. шапки ОРП (признак закрытой смены + чеков по кассе)
	Попытка
		Имя = Каталог + "orp_docs_" + Суффикс + ".csv";
		ЗаписатьТаблицу(ПолучитьШапкиОРП(Начало, Окончание), Имя,
			"Дата;Магазин;Касса;Документ;Чеков;Чеков возврата;Выручка",
			"Дата,Магазин,Касса,Документ,Чеков,ЧековВозврата,Выручка");
		Файлы.Добавить(Имя);
	Исключение
		ЗаписатьОшибку(Каталог, "orp_docs", ОписаниеОшибки());
	КонецПопытки;

	// 2. строки продаж
	Попытка
		Если ВРег(Источник) = "ЧЕКИ" Тогда
			Строки = ПолучитьСтрокиЧеков(Начало, Окончание);
		Иначе
			Строки = ПолучитьСтрокиОРП(Начало, Окончание);
		КонецЕсли;
		Имя = Каталог + "sales_" + Суффикс + ".csv";
		ЗаписатьТаблицу(Строки, Имя,
			"Дата;Время;Склад;Документ;Чек;Продавец;Номенклатура;Номенклатурная группа;Количество;Цена;Сумма;Скидка;Ручная скидка %;Дисконтная карта",
			"Дата,Время,Склад,Документ,Чек,Продавец,Номенклатура,Группа,Количество,Цена,Сумма,Скидка,РучнаяСкидка,Карта");
		Файлы.Добавить(Имя);
	Исключение
		ЗаписатьОшибку(Каталог, "sales", ОписаниеОшибки());
	КонецПопытки;

	// 3. остатки на конец периода
	Попытка
		Имя = Каталог + "stock_" + Формат(Окончание, "ДФ=yyyyMMdd") + ".csv";
		ЗаписатьТаблицу(ОтобратьСклады(ПолучитьОстатки(Окончание, СкладыСсылки), Склады), Имя,
			"Дата;Склад;Номенклатура;Номенклатурная группа;Характеристика;Остаток",
			"Дата,Склад,Номенклатура,Группа,Характеристика,Количество");
		Файлы.Добавить(Имя);
	Исключение
		ЗаписатьОшибку(Каталог, "stock", ОписаниеОшибки());
	КонецПопытки;

	// 4. поступления за период
	Попытка
		Имя = Каталог + "arrivals_" + Суффикс + ".csv";
		Поступления = ОтобратьСклады(ПолучитьПоступления(Начало, Окончание, СкладыСсылки), Склады);
		ДобавитьБрендИЦвет(Поступления);
		ЗаписатьТаблицу(Поступления, Имя,
			"Дата;Склад;Документ;Номенклатура;Номенклатурная группа;Характеристика;Поступило;Бренд;Цвет",
			"Дата,Склад,Документ,Номенклатура,Группа,Характеристика,Количество,Бренд,Цвет");
		Файлы.Добавить(Имя);
	Исключение
		ЗаписатьОшибку(Каталог, "arrivals", ОписаниеОшибки());
	КонецПопытки;

	Возврат Файлы;

КонецФункции

// Для автозапуска: вчера и позавчера (повтор безопасен — бот заменяет данные дня целиком).
Функция ВыгрузитьЗаПоследниеДни(КаталогВыгрузки, Источник = "Чеки", СкладыМагазинов = "ГОРОД_склад;МСЛ_Склад", ДнейНазад = 2) Экспорт
	Вчера = НачалоДня(ТекущаяДата()) - 86400;
	Возврат Выгрузить(Вчера - 86400 * (ДнейНазад - 1), Вчера, КаталогВыгрузки, Источник, СкладыМагазинов);
КонецФункции

// ============================================================================ ЧЕКИ ККМ
Функция ПолучитьСтрокиЧеков(Начало, Окончание)
	// Документ.ЧекККМ, ТЧ Товары (Склад, Продавец, Цена, Сумма, ПроцентСкидкиНаценки); шапка — КассаККМ, Продавец,
	// ДисконтнаяКарта, ВидОперации (Продажа / Возврат), СтатусЧекаККМ (Отложенный, Аннулированный, Пробитый, Архивный).
	// Чеки хранятся с 10.2024 — история выгружается из них. Продавец строки пуст — берём продавца чека.
	// «Чек» (касса + номер) и продавец склеиваются ниже, при обходе: ПРЕДСТАВЛЕНИЕ() внутри выражения запрос не выполнит.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка.Дата КАК ДатаВремя,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК Склад,
	|	Т.Ссылка.Номер КАК Документ,
	|	Т.Ссылка.КассаККМ КАК Касса,
	|	Т.Продавец КАК ПродавецСтроки,
	|	Т.Ссылка.Продавец КАК ПродавецЧека,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА -Т.Количество ИНАЧЕ Т.Количество КОНЕЦ КАК Количество,
	|	Т.Цена КАК Цена,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА -Т.Сумма ИНАЧЕ Т.Сумма КОНЕЦ КАК Сумма,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА 0 ИНАЧЕ Т.Цена * Т.Количество - Т.Сумма КОНЕЦ КАК Скидка,
	|	Т.ПроцентСкидкиНаценки КАК РучнаяСкидка,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка.ДисконтнаяКарта) КАК Карта
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.Ссылка.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый),
	|	                           ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Архивный))";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Т = Запрос.Выполнить().Выгрузить();
	Т.Колонки.Добавить("Время");
	Т.Колонки.Добавить("Чек");
	Т.Колонки.Добавить("Продавец");
	Для Каждого С Из Т Цикл
		С.Время = Формат(С.ДатаВремя, "ДФ=HH:mm");
		С.Чек = СокрЛП(Строка(С.Касса)) + " " + СокрЛП(С.Документ);
		С.Продавец = СокрЛП(Строка(?(ЗначениеЗаполнено(С.ПродавецСтроки), С.ПродавецСтроки, С.ПродавецЧека)));
	КонецЦикла;
	Возврат Т;
КонецФункции

// ============================================================================ ОТЧЕТЫ О РОЗНИЧНЫХ ПРОДАЖАХ
Функция ПолучитьСтрокиОРП(Начало, Окончание)
	// Документ.ОтчетОРозничныхПродажах, ТЧ Товары и ВозвращенныеТовары: Склад, Продавец, ДисконтнаяКарта (сверено).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	"""" КАК Время,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК Склад,
	|	Т.Ссылка.Номер КАК Документ,
	|	"""" КАК Чек,
	|	ПРЕДСТАВЛЕНИЕ(Т.Продавец) КАК Продавец,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	Т.Количество КАК Количество,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Цена * Т.Количество - Т.Сумма КАК Скидка,
	|	Т.ПроцентСкидкиНаценки КАК РучнаяСкидка,
	|	ПРЕДСТАВЛЕНИЕ(Т.ДисконтнаяКарта) КАК Карта
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И Т.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ВТ.Ссылка.Дата, ДЕНЬ), """", ПРЕДСТАВЛЕНИЕ(ВТ.Склад), ВТ.Ссылка.Номер, """",
	|	ПРЕДСТАВЛЕНИЕ(ВТ.Продавец), ПРЕДСТАВЛЕНИЕ(ВТ.Номенклатура), ПРЕДСТАВЛЕНИЕ(ВТ.Номенклатура.НоменклатурнаяГруппа),
	|	-ВТ.Количество, ВТ.Цена, -ВТ.Сумма, 0, 0, ПРЕДСТАВЛЕНИЕ(ВТ.ДисконтнаяКарта)
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.ВозвращенныеТовары КАК ВТ
	|ГДЕ
	|	ВТ.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И ВТ.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьШапкиОРП(Начало, Окончание)
	// Шапка ОРП (сверено): Магазин, КассаККМ, СуммаДокумента (выручка за вычетом возвратов: 18.10.2026 по МСЛ
	// 187 840 = сумме чеков дня с возвратом),
	// чеков — в доработанных реквизитах hiКоличествоЧеков / hiКоличествоЧековВозврата.
	// Магазин и касса — ссылки; в файл попадут их наименования (Значение_ → Строка()).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ) КАК Дата,
	|	Д.Магазин КАК Магазин,
	|	Д.КассаККМ КАК Касса,
	|	Д.Номер КАК Документ,
	|	Д.hiКоличествоЧеков КАК Чеков,
	|	Д.hiКоличествоЧековВозврата КАК ЧековВозврата,
	|	Д.СуммаДокумента КАК Выручка
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК Д
	|ГДЕ
	|	Д.Дата МЕЖДУ &Начало И &Окончание
	|	И Д.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// ============================================================================ ОСТАТКИ И ПОСТУПЛЕНИЯ
Функция ПолучитьОстатки(НаДату, СкладыСсылки)
	// РегистрНакопления.ТоварыНаСкладах (Склад, Номенклатура, ХарактеристикаНоменклатуры) — проверено Sync Admin.
	// Отбор складов — в параметрах виртуальной таблицы: в базе ~150 тыс. номенклатуры, сервер общий с Sync Admin.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(О.Склад) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(О.ХарактеристикаНоменклатуры) КАК Характеристика,
	|	О.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница, " + УсловиеСкладов(СкладыСсылки) + ") КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Склады", СкладыСсылки);
	Запрос.УстановитьПараметр("Дата", НачалоДня(НаДату));
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьПоступления(Начало, Окончание, СкладыСсылки)
	// Приход на склад, кроме возвратов от покупателей в рознице (ОРП / чеки).
	// РегистрНакопления.ТоварыНаСкладах — сверено (измерения Склад, Номенклатура, ХарактеристикаНоменклатуры).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(О.Период, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(О.Склад) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(О.Регистратор) КАК Документ,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(О.ХарактеристикаНоменклатуры) КАК Характеристика,
	|	О.Номенклатура КАК НоменклатураСсылка,
	|	О.КоличествоПриход КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(&Начало, &Окончание, Регистратор, " + УсловиеСкладов(СкладыСсылки) + ") КАК О
	|ГДЕ
	|	О.КоличествоПриход > 0
	|	И НЕ О.Регистратор ССЫЛКА Документ.ОтчетОРозничныхПродажах
	|	И НЕ О.Регистратор ССЫЛКА Документ.ЧекККМ";
	Запрос.УстановитьПараметр("Склады", СкладыСсылки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Бренд и цвет из карточки номенклатуры — для карточек новинок в боте «Обучение».
// Цвет — реквизит hiЦвет (читает и Sync Admin), бренд — реквизит Бренд (справочник «Бренды»), оба сверены;
// Производитель — запасной. У всех моделей в «Бренд» стоит «МСЛ» (магазины мультибрендовые, настоящий бренд —
// в наименовании) — бот такое значение пропускает (config: onec.ignore_brands). Только для поступлений.
Процедура ДобавитьБрендИЦвет(Таблица)
	Таблица.Колонки.Добавить("Бренд");
	Таблица.Колонки.Добавить("Цвет");
	Для Каждого С Из Таблица Цикл
		С.Бренд = СвойствоНоменклатуры(С.НоменклатураСсылка, "Бренд;Производитель");
		С.Цвет = СвойствоНоменклатуры(С.НоменклатураСсылка, "hiЦвет");
	КонецЦикла;
КонецПроцедуры

Функция СвойствоНоменклатуры(Ссылка, Имена)
	Для Каждого Имя Из РазложитьСтроку(Имена) Цикл
		Попытка
			Зн = СокрЛП(Строка(Ссылка[Имя]));
			Если Зн <> "" Тогда
				Возврат Зн;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат "";
КонецФункции

// ============================================================================ ПРОВЕРКА БАЗЫ
// Отчёт для настройки обработки: какие документы, реквизиты, перечисления, склады и кассы есть в базе, сколько чеков
// и ОРП хранится по месяцам, где бренд товара, и пробный запуск каждого запроса выгрузки за вчера.
// Только читает. Продавцов не называет — только их количество. Файл check_*.txt бот не загружает.
Функция ПроверитьБазу(Каталог, ПодстрокиСкладов = "ГОРОД_склад;МСЛ_Склад") Экспорт
	Отчет = Новый Массив;
	СИ = Новый СистемнаяИнформация;
	Отчет.Добавить("Проверка базы для awer-sales-bot, " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm'"));
	Отчет.Добавить("Платформа " + СИ.ВерсияПриложения + "; конфигурация «" + Метаданные.Синоним + "» " + Метаданные.Версия);
	Папка = Новый Файл(Каталог); // в две строки: «Новый Файл(…).Существует()» платформа 8.3.9 не разбирает
	Отчет.Добавить("Папка для бота: " + Каталог + ?(Папка.Существует(), "", " — НЕ НАЙДЕНА"));

	Отчет.Добавить("");
	Отчет.Добавить("== Метаданные");
	ОписатьДокумент(Отчет, "ЧекККМ", "ЧЕК");
	ОписатьДокумент(Отчет, "ОтчетОРозничныхПродажах", "РОЗНИЧ");
	ОписатьПеречисление(Отчет, "ВидыОперацийЧекККМ", "ЧЕК");
	ОписатьПеречисление(Отчет, "СтатусыЧековККМ", "ЧЕК");
	МД = Метаданные.РегистрыНакопления.Найти("ТоварыНаСкладах");
	Если МД <> Неопределено Тогда
		Отчет.Добавить("РегистрНакопления.ТоварыНаСкладах — измерения: " + ИменаОбъектов(МД.Измерения)
			+ "; ресурсы: " + ИменаОбъектов(МД.Ресурсы));
	КонецЕсли;
	МД = Метаданные.Справочники.Найти("Номенклатура");
	Если МД <> Неопределено Тогда
		Отчет.Добавить("Справочник.Номенклатура — реквизиты: " + ИменаОбъектов(МД.Реквизиты));
	КонецЕсли;
	Похожие = "";
	Для Каждого С Из Метаданные.Справочники Цикл
		Если ЕстьСлово(С.Имя, "БРЕНД;МАРК;ПРОИЗВОД") Тогда
			Похожие = Похожие + ?(Похожие = "", "", ", ") + С.Имя;
		КонецЕсли;
	КонецЦикла;
	Отчет.Добавить("Справочники, похожие на бренд: " + ?(Похожие = "", "нет", Похожие));
	Для Каждого П Из Метаданные.ПланыВидовХарактеристик Цикл
		Отчет.Добавить("ПланВидовХарактеристик." + П.Имя + ": " + Наименования("ПланВидовХарактеристик." + П.Имя, 60));
	КонецЦикла;

	Отчет.Добавить("");
	Отчет.Добавить("== Склады и кассы");
	Отчет.Добавить("Склады: " + Наименования("Справочник.Склады", 200));
	Склады = РазложитьСтроку(ПодстрокиСкладов);
	Найдены = "";
	Для Каждого Ссылка Из НайтиСклады(Склады) Цикл
		Найдены = Найдены + ?(Найдены = "", "", ", ") + Строка(Ссылка);
	КонецЦикла;
	Отчет.Добавить("Склады магазинов по «" + ПодстрокиСкладов + "»: " + ?(Найдены = "", "НЕ НАЙДЕНЫ", Найдены));

	Отчет.Добавить("");
	Отчет.Добавить("== Сколько документов хранится (по месяцам, за 2 года)");
	ДокументыПоМесяцам(Отчет, "ЧекККМ");
	ДокументыПоМесяцам(Отчет, "ОтчетОРозничныхПродажах");
	ВыполнитьВОтчет(Отчет, "Чеки за 30 дней по статусу и виду операции",
		"ВЫБРАТЬ Д.СтатусЧекаККМ КАК Статус, Д.ВидОперации КАК Вид, КОЛИЧЕСТВО(*) КАК Н
		|ИЗ Документ.ЧекККМ КАК Д ГДЕ Д.Дата >= &С
		|СГРУППИРОВАТЬ ПО Д.СтатусЧекаККМ, Д.ВидОперации");
	ВыполнитьВОтчет(Отчет, "Продавцов в чеках за 30 дней (сколько разных)",
		"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Продавец) КАК Н ИЗ Документ.ЧекККМ.Товары КАК Т ГДЕ Т.Ссылка.Дата >= &С");
	ВыполнитьВОтчет(Отчет, "Продавцов в ОРП за 30 дней (сколько разных)",
		"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Продавец) КАК Н ИЗ Документ.ОтчетОРозничныхПродажах.Товары КАК Т
		|ГДЕ Т.Ссылка.Дата >= &С");

	Отчет.Добавить("");
	Отчет.Добавить("== Пробный запуск запросов выгрузки за вчера");
	Начало = НачалоДня(ТекущаяДата()) - 86400;
	Окончание = КонецДня(Начало);
	СкладыСсылки = НайтиСклады(Склады);
	Попытка
		Т = ПолучитьСтрокиЧеков(Начало, Окончание);
		Отчет.Добавить("Строки чеков: OK, строк " + Т.Количество() + "; склады: " + ПоЗначениям(Т, "Склад"));
	Исключение
		Отчет.Добавить("Строки чеков: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Т = ПолучитьСтрокиОРП(Начало, Окончание);
		Отчет.Добавить("Строки ОРП: OK, строк " + Т.Количество() + "; склады: " + ПоЗначениям(Т, "Склад"));
	Исключение
		Отчет.Добавить("Строки ОРП: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Т = ПолучитьШапкиОРП(Начало, Окончание);
		Отчет.Добавить("Шапки ОРП: OK, документов " + Т.Количество() + "; кассы: " + ПоЗначениям(Т, "Касса"));
	Исключение
		Отчет.Добавить("Шапки ОРП: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Т = ОтобратьСклады(ПолучитьОстатки(Окончание, СкладыСсылки), Склады);
		Отчет.Добавить("Остатки: OK, строк " + Т.Количество() + "; склады: " + ПоЗначениям(Т, "Склад"));
	Исключение
		Отчет.Добавить("Остатки: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Т = ОтобратьСклады(ПолучитьПоступления(Начало - 86400 * 89, Окончание, СкладыСсылки), Склады);
		Отчет.Добавить("Поступления за 90 дней: OK, строк " + Т.Количество());
		ПробаБрендаИЦвета(Отчет, Т);
	Исключение
		Отчет.Добавить("Поступления: ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;

	Имя = ДобавитьРазделитель(Каталог) + "check_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd-HHmmss") + ".txt";
	Запись = Новый ЗаписьТекста(Имя, КодировкаТекста.UTF8);
	Для Каждого Строка_ Из Отчет Цикл
		Запись.ЗаписатьСтроку(Строка_);
	КонецЦикла;
	Запись.Закрыть();
	Возврат Имя;
КонецФункции

Процедура ОписатьДокумент(Отчет, Имя, Слово)
	МД = Метаданные.Документы.Найти(Имя);
	Если МД = Неопределено Тогда
		Похожие = "";
		Для Каждого Д Из Метаданные.Документы Цикл
			Если ЕстьСлово(Д.Имя, Слово) Тогда
				Похожие = Похожие + ?(Похожие = "", "", ", ") + Д.Имя;
			КонецЕсли;
		КонецЦикла;
		Отчет.Добавить("Документ." + Имя + ": НЕТ. Похожие: " + ?(Похожие = "", "нет", Похожие));
		Возврат;
	КонецЕсли;
	Отчет.Добавить("Документ." + Имя + " — реквизиты: " + ИменаОбъектов(МД.Реквизиты));
	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Отчет.Добавить("    ТЧ " + ТЧ.Имя + ": " + ИменаОбъектов(ТЧ.Реквизиты));
	КонецЦикла;
КонецПроцедуры

Процедура ОписатьПеречисление(Отчет, Имя, Слово)
	МД = Метаданные.Перечисления.Найти(Имя);
	Если МД <> Неопределено Тогда
		Отчет.Добавить("Перечисление." + Имя + ": " + ИменаОбъектов(МД.ЗначенияПеречисления));
		Возврат;
	КонецЕсли;
	Похожие = "";
	Для Каждого П Из Метаданные.Перечисления Цикл
		Если ЕстьСлово(П.Имя, Слово) Тогда
			Похожие = Похожие + ?(Похожие = "", "", "; ") + П.Имя + ": " + ИменаОбъектов(П.ЗначенияПеречисления);
		КонецЕсли;
	КонецЦикла;
	Отчет.Добавить("Перечисление." + Имя + ": НЕТ. Похожие: " + ?(Похожие = "", "нет", Похожие));
КонецПроцедуры

Процедура ДокументыПоМесяцам(Отчет, Имя)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) КАК М, КОЛИЧЕСТВО(*) КАК Н
		|ИЗ Документ." + Имя + " КАК Д ГДЕ Д.Дата >= &С И НЕ Д.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО НАЧАЛОПЕРИОДА(Д.Дата, МЕСЯЦ) УПОРЯДОЧИТЬ ПО М");
		Запрос.УстановитьПараметр("С", ДобавитьМесяц(НачалоМесяца(ТекущаяДата()), -24));
		Выборка = Запрос.Выполнить().Выбрать();
		Текст = "";
		Пока Выборка.Следующий() Цикл
			Текст = Текст + ?(Текст = "", "", ", ") + Формат(Выборка.М, "ДФ=MM.yyyy") + ": " + Выборка.Н;
		КонецЦикла;
		Отчет.Добавить(Имя + ": " + ?(Текст = "", "нет документов", Текст));
	Исключение
		Отчет.Добавить(Имя + ": ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Запрос с параметром &С (30 дней назад): строки результата через «; » — колонки через « / ».
Процедура ВыполнитьВОтчет(Отчет, Заголовок, ТекстЗапроса)
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("С", НачалоДня(ТекущаяДата()) - 86400 * 30);
		Т = Запрос.Выполнить().Выгрузить();
		Текст = "";
		Для Каждого С Из Т Цикл
			Ячейки = "";
			Для Каждого К Из Т.Колонки Цикл
				Ячейки = Ячейки + ?(Ячейки = "", "", " / ") + Строка(С[К.Имя]);
			КонецЦикла;
			Текст = Текст + ?(Текст = "", "", "; ") + Ячейки;
		КонецЦикла;
		Отчет.Добавить(Заголовок + ": " + ?(Текст = "", "нет", Текст));
	Исключение
		Отчет.Добавить(Заголовок + ": ОШИБКА " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Наименования элементов справочника / плана видов характеристик (не помеченных на удаление), до Сколько штук.
Функция Наименования(ПолноеИмя, Сколько)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Сколько, "ЧГ=0") + " С.Наименование КАК Н
		|ИЗ " + ПолноеИмя + " КАК С ГДЕ НЕ С.ПометкаУдаления УПОРЯДОЧИТЬ ПО С.Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Текст = "";
		Пока Выборка.Следующий() Цикл
			Текст = Текст + ?(Текст = "", "", "; ") + СокрЛП(Выборка.Н);
		КонецЦикла;
		Возврат ?(Текст = "", "пусто", Текст);
	Исключение
		Возврат "ОШИБКА " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// Разные значения колонки с числом строк: «ГОРОД (120); МСЛ (80)».
Функция ПоЗначениям(Таблица, Колонка)
	Счет = Новый Соответствие;
	Для Каждого С Из Таблица Цикл
		Ключ = СокрЛП(Строка(С[Колонка]));
		Счет.Вставить(Ключ, ?(Счет[Ключ] = Неопределено, 0, Счет[Ключ]) + 1);
	КонецЦикла;
	Текст = "";
	Для Каждого Э Из Счет Цикл
		Текст = Текст + ?(Текст = "", "", "; ") + ?(Э.Ключ = "", "(пусто)", Э.Ключ) + " (" + Э.Значение + ")";
	КонецЦикла;
	Возврат ?(Текст = "", "—", Текст);
КонецФункции

// Какой реквизит номенклатуры хранит бренд и цвет: заполненность на 30 поступивших моделях и пример значения.
Процедура ПробаБрендаИЦвета(Отчет, Поступления)
	Модели = Новый Массив;
	Для Каждого С Из Поступления Цикл
		Если Модели.Найти(С.НоменклатураСсылка) = Неопределено Тогда
			Модели.Добавить(С.НоменклатураСсылка);
		КонецЕсли;
		Если Модели.Количество() >= 30 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Имена = "hiБренд;Бренд;Марка;Производитель;hiМарка;hiПроизводитель;hiЦвет;Цвет";
	Для Каждого Имя Из РазложитьСтроку(Имена) Цикл
		Заполнено = 0;
		Пример = "";
		НетРеквизита = Ложь;
		Для Каждого Ссылка Из Модели Цикл
			Попытка
				Зн = СокрЛП(Строка(Ссылка[Имя]));
			Исключение
				НетРеквизита = Истина;
				Прервать;
			КонецПопытки;
			Если Зн <> "" Тогда
				Заполнено = Заполнено + 1;
				Пример = ?(Пример = "", Зн, Пример);
			КонецЕсли;
		КонецЦикла;
		Отчет.Добавить("    " + Имя + ": " + ?(НетРеквизита, "нет такого реквизита",
			"заполнено у " + Заполнено + " из " + Модели.Количество() + ?(Пример = "", "", ", например «" + Пример + "»")));
	КонецЦикла;
КонецПроцедуры

Функция ИменаОбъектов(Коллекция)
	Текст = "";
	Для Каждого Э Из Коллекция Цикл
		Текст = Текст + ?(Текст = "", "", ", ") + Э.Имя;
	КонецЦикла;
	Возврат ?(Текст = "", "—", Текст);
КонецФункции

Функция ЕстьСлово(Имя, Слова)
	Для Каждого Слово Из РазложитьСтроку(Слова) Цикл
		Если Найти(ВРег(Имя), Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// ============================================================================ СЛУЖЕБНЫЕ
// Склады магазинов по подстрокам названий («ГОРОД_склад;МСЛ_Склад»). Справочник.Склады проверен Sync Admin.
Функция НайтиСклады(Подстроки)
	Результат = Новый Массив;
	Если Подстроки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Ссылка, С.Наименование КАК Наименование
	|ИЗ Справочник.Склады КАК С ГДЕ НЕ С.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Подстрока Из Подстроки Цикл
			Если Найти(ВРег(Выборка.Наименование), ВРег(Подстрока)) > 0 Тогда
				Результат.Добавить(Выборка.Ссылка);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Условие виртуальной таблицы регистра; складов не нашли — без отбора (дальше отберёт ОтобратьСклады).
Функция УсловиеСкладов(СкладыСсылки)
	Возврат ?(СкладыСсылки.Количество() > 0, "Склад В (&Склады)", "");
КонецФункции

// Ошибка раздела: в журнал регистрации и файлом error_*.txt в папку бота — бот перешлёт её владельцу.
Процедура ЗаписатьОшибку(Каталог, Раздел, Текст) Экспорт
	ЗаписьЖурналаРегистрации("ВыгрузкаПродажДляБота", УровеньЖурналаРегистрации.Ошибка, , , Раздел + ": " + Текст);
	Сообщить("Не выгружено (" + Раздел + "): " + Текст); // при ручном запуске — видно сразу
	Попытка
		Имя = ДобавитьРазделитель(Каталог) + "error_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd-HHmmss") + "_" + Раздел + ".txt";
		Запись = Новый ЗаписьТекста(Имя + ".part", КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку(Раздел + ": " + Текст);
		Запись.Закрыть();
		ПереместитьФайл(Имя + ".part", Имя);
	Исключение
		// папка недоступна — остаётся запись в журнале регистрации
	КонецПопытки;
КонецПроцедуры

Функция ОтобратьСклады(Таблица, Склады)
	Если Склады.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	Результат = Таблица.СкопироватьКолонки();
	Для Каждого С Из Таблица Цикл
		Для Каждого Подстрока Из Склады Цикл
			Если Найти(ВРег(С.Склад), ВРег(Подстрока)) > 0 Тогда
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), С);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Колонки — имена колонок таблицы через запятую в порядке заголовка.
Процедура ЗаписатьТаблицу(Таблица, ИмяФайла, Заголовок, Колонки)
	// Пишем во временный файл и переименовываем: бот берёт только *.csv и не прочитает недописанный файл.
	Имена = РазложитьСтроку(СтрЗаменить(Колонки, ",", ";"));
	Временный = ИмяФайла + ".part";
	Запись = Новый ЗаписьТекста(Временный, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(Заголовок);
	Для Каждого С Из Таблица Цикл
		Стр = "";
		Для Инд = 0 По Имена.ВГраница() Цикл
			Стр = Стр + ?(Инд = 0, "", ";") + Значение_(С[Имена[Инд]]);
		КонецЦикла;
		Запись.ЗаписатьСтроку(Стр);
	КонецЦикла;
	Запись.Закрыть();
	Итоговый = Новый Файл(ИмяФайла);
	Если Итоговый.Существует() Тогда
		УдалитьФайлы(ИмяФайла);
	КонецЕсли;
	ПереместитьФайл(Временный, ИмяФайла);
КонецПроцедуры

Функция Значение_(З)
	Если ТипЗнч(З) = Тип("Дата") Тогда
		Возврат Формат(З, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(З) = Тип("Число") Тогда
		Возврат Формат(З, "ЧРД=.; ЧГ=0; ЧН=0");
	КонецЕсли;
	// «;» — разделитель; перевод строки и возврат каретки рвут строку; кавычка в начале значения
	// заставит Python склеить все следующие строки файла в одну
	С = СтрЗаменить(СокрЛП(Строка(З)), ";", ",");
	С = СтрЗаменить(СтрЗаменить(С, Символы.ПС, " "), Символы.ВК, " ");
	Возврат СтрЗаменить(С, """", "'");
КонецФункции

Функция РазложитьСтроку(Строка_)
	Результат = Новый Массив;
	Остаток = Строка_;
	Пока Остаток <> "" Цикл
		Поз = Найти(Остаток, ";");
		Часть = СокрЛП(?(Поз > 0, Лев(Остаток, Поз - 1), Остаток));
		Если Часть <> "" Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
		Остаток = ?(Поз > 0, Сред(Остаток, Поз + 1), "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДобавитьРазделитель(Каталог)
	Если Прав(Каталог, 1) = "\" Или Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат Каталог + "\";
КонецФункции
