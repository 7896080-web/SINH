// ============================================================================
// Внешняя обработка «Выгрузка продаж для бота» (ВыгрузкаПродажДляБота.epf). Обычное приложение.
//
// Файлы в папку «входящие» бота за период:
//   sales_*.csv    — строки продаж по продавцам. Источник: ЧЕКИ ККМ (если хранятся — информативнее:
//                    номер чека, время → средний чек и вещей в чеке по каждому продавцу) или ОРП (сводно).
//       Дата;Время;Склад;Документ;Чек;Продавец;Номенклатура;Номенклатурная группа;Количество;Цена;Сумма;Скидка;
//       Ручная скидка %;Дисконтная карта
//   orp_docs_*.csv — шапки «Отчетов о розничных продажах» (чеков, выручка) — для среднего чека магазина
//                    и как признак «смена закрыта».
//   stock_*.csv    — остатки на складах магазинов на конец периода.
//   arrivals_*.csv — поступления на склады магазинов за период.
//
// !!! ПРОВЕРИТЬ В КОНФИГУРАТОРЕ имена объектов/реквизитов (места помечены «ПРОВЕРИТЬ»).
//     Конструктор запроса подсветит поле, которого нет.
// ============================================================================

// Источник: "Чеки" или "ОРП". Склады магазинов — подстроки названий через ";" (например "ГОРОД;МСЛ").
Функция Выгрузить(ДатаНачала, ДатаОкончания, КаталогВыгрузки, Источник = "Чеки", СкладыМагазинов = "ГОРОД;МСЛ") Экспорт

	Начало = НачалоДня(ДатаНачала);
	Окончание = КонецДня(ДатаОкончания);
	Суффикс = Формат(Начало, "ДФ=yyyyMMdd") + "_" + Формат(Окончание, "ДФ=yyyyMMdd");
	Каталог = ДобавитьРазделитель(КаталогВыгрузки);
	Склады = РазложитьСтроку(СкладыМагазинов);
	Файлы = Новый Массив;

	// 1. шапки ОРП (признак закрытой смены + чеков по кассе)
	Имя = Каталог + "orp_docs_" + Суффикс + ".csv";
	ЗаписатьТаблицу(ПолучитьШапкиОРП(Начало, Окончание), Имя,
		"Дата;Магазин;Касса;Документ;Чеков;Чеков возврата;Выручка",
		"Дата,Касса,Касса,Документ,Чеков,ЧековВозврата,Выручка");
	Файлы.Добавить(Имя);

	// 2. строки продаж
	Если ВРег(Источник) = "ЧЕКИ" Тогда
		Строки = ПолучитьСтрокиЧеков(Начало, Окончание);
	Иначе
		Строки = ПолучитьСтрокиОРП(Начало, Окончание);
	КонецЕсли;
	Имя = Каталог + "sales_" + Суффикс + ".csv";
	ЗаписатьТаблицу(Строки, Имя,
		"Дата;Время;Склад;Документ;Чек;Продавец;Номенклатура;Номенклатурная группа;Количество;Цена;Сумма;Скидка;Ручная скидка %;Дисконтная карта",
		"Дата,Время,Склад,Документ,Чек,Продавец,Номенклатура,Группа,Количество,Цена,Сумма,Скидка,РучнаяСкидка,Карта");
	Файлы.Добавить(Имя);

	// 3. остатки на конец периода
	Имя = Каталог + "stock_" + Формат(Окончание, "ДФ=yyyyMMdd") + ".csv";
	ЗаписатьТаблицу(ОтобратьСклады(ПолучитьОстатки(Окончание), Склады), Имя,
		"Дата;Склад;Номенклатура;Номенклатурная группа;Характеристика;Остаток",
		"Дата,Склад,Номенклатура,Группа,Характеристика,Количество");
	Файлы.Добавить(Имя);

	// 4. поступления за период
	Имя = Каталог + "arrivals_" + Суффикс + ".csv";
	ЗаписатьТаблицу(ОтобратьСклады(ПолучитьПоступления(Начало, Окончание), Склады), Имя,
		"Дата;Склад;Документ;Номенклатура;Номенклатурная группа;Характеристика;Поступило",
		"Дата,Склад,Документ,Номенклатура,Группа,Характеристика,Количество");
	Файлы.Добавить(Имя);

	Возврат Файлы;

КонецФункции

// Для автозапуска: вчера и позавчера (повтор безопасен — бот заменяет данные дня целиком).
Функция ВыгрузитьЗаПоследниеДни(КаталогВыгрузки, Источник = "Чеки", СкладыМагазинов = "ГОРОД;МСЛ", ДнейНазад = 2) Экспорт
	Вчера = НачалоДня(ТекущаяДата()) - 86400;
	Возврат Выгрузить(Вчера - 86400 * (ДнейНазад - 1), Вчера, КаталогВыгрузки, Источник, СкладыМагазинов);
КонецФункции

// ============================================================================ ЧЕКИ ККМ
Функция ПолучитьСтрокиЧеков(Начало, Окончание)
	// ПРОВЕРИТЬ: Документ.ЧекККМ (ТЧ «Товары»), реквизиты шапки: Склад, ДисконтнаяКарта, ВидОперации (Продажа/Возврат),
	//   статус чека (Перечисление.СтатусыЧековККМ: Пробитый / Архивный / Отложенный);
	//   колонка продавца — в ТЧ (Товары.Продавец) или в шапке (Ссылка.Продавец / Ссылка.Кассир);
	//   ручная скидка — Товары.ПроцентСкидкиНаценки (если это «% Руч. ск.»).
	// Чеки должны храниться после закрытия смены (статус «Архивный»). Если в базе их нет — Источник = "ОРП".
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка.Дата КАК ДатаВремя,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка.Склад) КАК Склад,
	|	Т.Ссылка.Номер КАК Документ,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка.КассаККМ) + "" "" + Т.Ссылка.Номер КАК Чек,
	|	ПРЕДСТАВЛЕНИЕ(Т.Продавец) КАК Продавец,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА -Т.Количество ИНАЧЕ Т.Количество КОНЕЦ КАК Количество,
	|	Т.Цена КАК Цена,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА -Т.Сумма ИНАЧЕ Т.Сумма КОНЕЦ КАК Сумма,
	|	ВЫБОР КОГДА Т.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Возврат)
	|		ТОГДА 0 ИНАЧЕ Т.Цена * Т.Количество - Т.Сумма КОНЕЦ КАК Скидка,
	|	Т.ПроцентСкидкиНаценки КАК РучнаяСкидка,
	|	ПРЕДСТАВЛЕНИЕ(Т.Ссылка.ДисконтнаяКарта) КАК Карта
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.Ссылка.СтатусЧекаККМ В (ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробитый),
	|	                           ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Архивный))";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Т = Запрос.Выполнить().Выгрузить();
	Т.Колонки.Добавить("Время");
	Для Каждого С Из Т Цикл
		С.Время = Формат(С.ДатаВремя, "ДФ=HH:mm");
	КонецЦикла;
	Возврат Т;
КонецФункции

// ============================================================================ ОТЧЕТЫ О РОЗНИЧНЫХ ПРОДАЖАХ
Функция ПолучитьСтрокиОРП(Начало, Окончание)
	// ПРОВЕРИТЬ: Документ.ОтчетОРозничныхПродажах, ТЧ «Товары» (Продавец, Склад, ДисконтнаяКарта, ПроцентСкидкиНаценки)
	//            и ТЧ «ВозвращенныеТовары» (есть ли там Продавец / Склад / ДисконтнаяКарта).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	"""" КАК Время,
	|	ПРЕДСТАВЛЕНИЕ(Т.Склад) КАК Склад,
	|	Т.Ссылка.Номер КАК Документ,
	|	"""" КАК Чек,
	|	ПРЕДСТАВЛЕНИЕ(Т.Продавец) КАК Продавец,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	Т.Количество КАК Количество,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.Цена * Т.Количество - Т.Сумма КАК Скидка,
	|	Т.ПроцентСкидкиНаценки КАК РучнаяСкидка,
	|	ПРЕДСТАВЛЕНИЕ(Т.ДисконтнаяКарта) КАК Карта
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И Т.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(В.Ссылка.Дата, ДЕНЬ), """", ПРЕДСТАВЛЕНИЕ(В.Склад), В.Ссылка.Номер, """",
	|	ПРЕДСТАВЛЕНИЕ(В.Продавец), ПРЕДСТАВЛЕНИЕ(В.Номенклатура), ПРЕДСТАВЛЕНИЕ(В.Номенклатура.НоменклатурнаяГруппа),
	|	-В.Количество, В.Цена, -В.Сумма, 0, 0, """"
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.ВозвращенныеТовары КАК В
	|ГДЕ
	|	В.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И В.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьШапкиОРП(Начало, Окончание)
	// ПРОВЕРИТЬ: реквизиты шапки КассаККМ, КоличествоЧеков, КоличествоЧековВозврата.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Д.КассаККМ) КАК Касса,
	|	Д.Номер КАК Документ,
	|	Д.КоличествоЧеков КАК Чеков,
	|	Д.КоличествоЧековВозврата КАК ЧековВозврата,
	|	ЕСТЬNULL(СУММА(Т.Сумма), 0) КАК Выручка
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК Д
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОРозничныхПродажах.Товары КАК Т
	|		ПО Т.Ссылка = Д.Ссылка
	|ГДЕ
	|	Д.Дата МЕЖДУ &Начало И &Окончание
	|	И Д.Проведен
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Д.Дата, ДЕНЬ), ПРЕДСТАВЛЕНИЕ(Д.КассаККМ), Д.Номер, Д.КоличествоЧеков, Д.КоличествоЧековВозврата";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// ============================================================================ ОСТАТКИ И ПОСТУПЛЕНИЯ
Функция ПолучитьОстатки(НаДату)
	// ПРОВЕРИТЬ: РегистрНакопления.ТоварыНаСкладах (измерения Склад, Номенклатура, ХарактеристикаНоменклатуры).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(О.Склад) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(О.ХарактеристикаНоменклатуры) КАК Характеристика,
	|	О.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Граница) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Дата", НачалоДня(НаДату));
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьПоступления(Начало, Окончание)
	// Приход на склад, кроме возвратов от покупателей в рознице (ОРП / чеки).
	// ПРОВЕРИТЬ имена регистра и измерений (как в ПолучитьОстатки).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(О.Период, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(О.Склад) КАК Склад,
	|	ПРЕДСТАВЛЕНИЕ(О.Регистратор) КАК Документ,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(О.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(О.ХарактеристикаНоменклатуры) КАК Характеристика,
	|	О.КоличествоПриход КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(&Начало, &Окончание, Регистратор, ) КАК О
	|ГДЕ
	|	О.КоличествоПриход > 0
	|	И НЕ О.Регистратор ССЫЛКА Документ.ОтчетОРозничныхПродажах
	|	И НЕ О.Регистратор ССЫЛКА Документ.ЧекККМ";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// ============================================================================ СЛУЖЕБНЫЕ
Функция ОтобратьСклады(Таблица, Склады)
	Если Склады.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	Результат = Таблица.СкопироватьКолонки();
	Для Каждого С Из Таблица Цикл
		Для Каждого Подстрока Из Склады Цикл
			Если Найти(ВРег(С.Склад), ВРег(Подстрока)) > 0 Тогда
				ЗаполнитьЗначенияСвойств(Результат.Добавить(), С);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Колонки — имена колонок таблицы через запятую в порядке заголовка.
Процедура ЗаписатьТаблицу(Таблица, ИмяФайла, Заголовок, Колонки)
	Имена = РазложитьСтроку(СтрЗаменить(Колонки, ",", ";"));
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(Заголовок);
	Для Каждого С Из Таблица Цикл
		Стр = "";
		Для Инд = 0 По Имена.ВГраница() Цикл
			Стр = Стр + ?(Инд = 0, "", ";") + Значение_(С[Имена[Инд]]);
		КонецЦикла;
		Запись.ЗаписатьСтроку(Стр);
	КонецЦикла;
	Запись.Закрыть();
КонецПроцедуры

Функция Значение_(З)
	Если ТипЗнч(З) = Тип("Дата") Тогда
		Возврат Формат(З, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(З) = Тип("Число") Тогда
		Возврат Формат(З, "ЧРД=.; ЧГ=0; ЧН=0");
	КонецЕсли;
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(Строка(З)), ";", ","), Символы.ПС, " ");
КонецФункции

Функция РазложитьСтроку(Строка_)
	Результат = Новый Массив;
	Остаток = Строка_;
	Пока Остаток <> "" Цикл
		Поз = Найти(Остаток, ";");
		Часть = СокрЛП(?(Поз > 0, Лев(Остаток, Поз - 1), Остаток));
		Если Часть <> "" Тогда
			Результат.Добавить(Часть);
		КонецЕсли;
		Остаток = ?(Поз > 0, Сред(Остаток, Поз + 1), "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДобавитьРазделитель(Каталог)
	Если Прав(Каталог, 1) = "\" Или Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат Каталог + "\";
КонецФункции
