// ============================================================================
// Внешняя обработка «Выгрузка продаж для бота» (ВыгрузкаПродажДляБота.epf)
// Выгружает строки чеков (продажи и возвраты) за период в CSV для awer-sales-bot.
// Формат: Дата;Магазин;Продавец;Чек;Номенклатура;Номенклатурная группа;Количество;Сумма
//
// !!! ПРОВЕРИТЬ В КОНФИГУРАТОРЕ имена объектов и реквизитов вашей конфигурации —
//     места помечены «ПРОВЕРИТЬ». Код написан под 1С:Розница 2.x/3.x.
//     Если продавец хранится не в строке чека, а в шапке (Кассир/Продавец) — см. вариант в тексте запроса.
// ============================================================================

#Область ПрограммныйИнтерфейс

// Основная процедура. Можно вызывать из формы, из регламентного задания (БСП) или внешнего соединения.
//
// Параметры:
//   ДатаНачала, ДатаОкончания - Дата - период выгрузки (включительно).
//   КаталогВыгрузки           - Строка - папка «входящие» бота (локальная или сетевая \\server\inbox).
//   АдресСервиса              - Строка - необязательно: http://host:8080/api/upload — отправка по HTTP.
//   ТокенСервиса              - Строка - значение UPLOAD_TOKEN из .env бота.
//   ТолькоЗакрытыеСмены       - Булево - выгружать только чеки закрытых смен (после «Отчета о розничных продажах»).
//
// Возвращаемое значение:
//   Строка - полное имя созданного файла.
Функция Выгрузить(ДатаНачала, ДатаОкончания, КаталогВыгрузки = "", АдресСервиса = "", ТокенСервиса = "",
	ТолькоЗакрытыеСмены = Истина) Экспорт

	Таблица = ПолучитьСтрокиЧеков(НачалоДня(ДатаНачала), КонецДня(ДатаОкончания), ТолькоЗакрытыеСмены);

	ИмяФайла = "sales_" + Формат(ДатаНачала, "ДФ=yyyyMMdd") + "_" + Формат(ДатаОкончания, "ДФ=yyyyMMdd")
		+ "_" + Формат(ТекущаяДатаСеанса(), "ДФ=HHmmss") + ".csv";
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		ПолноеИмя = ПолучитьИмяВременногоФайла("csv");
	Иначе
		ПолноеИмя = ДобавитьРазделитель(КаталогВыгрузки) + ИмяФайла;
	КонецЕсли;

	ЗаписатьCSV(Таблица, ПолноеИмя);

	Если Не ПустаяСтрока(АдресСервиса) Тогда
		ОтправитьНаСервис(ПолноеИмя, ИмяФайла, АдресСервиса, ТокенСервиса);
	КонецЕсли;

	Возврат ПолноеИмя;

КонецФункции

// Для регламентного запуска: вчера и позавчера (повторная выгрузка безопасна — бот заменяет данные дня).
Процедура ВыгрузитьЗаПоследниеДни(КаталогВыгрузки = "", АдресСервиса = "", ТокенСервиса = "", ДнейНазад = 2) Экспорт
	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Выгрузить(Вчера - 86400 * (ДнейНазад - 1), Вчера, КаталогВыгрузки, АдресСервиса, ТокенСервиса, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтрокиЧеков(Начало, Окончание, ТолькоЗакрытыеСмены)

	Запрос = Новый Запрос;
	// ПРОВЕРИТЬ: Документ.ЧекККМ / Документ.ЧекККМВозврат, ТЧ «Товары», реквизит строки «Продавец»,
	//            реквизит шапки «Магазин», перечисление СтатусыЧековККМ, реквизит Номенклатуры «НоменклатурнаяГруппа».
	//            Если продавец в шапке — замените «Товары.Продавец» на «Товары.Ссылка.Продавец» (или «.Кассир»).
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Товары.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Ссылка.Магазин) КАК Магазин,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Продавец) КАК Продавец,
	|	Товары.Ссылка.Номер КАК Чек,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	|	Товары.Количество КАК Количество,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЧекККМ.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И НЕ Товары.Ссылка.ПометкаУдаления
	|	И (Товары.Ссылка.Статус В (&Статусы))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Товары.Ссылка.Дата, ДЕНЬ),
	|	ПРЕДСТАВЛЕНИЕ(Товары.Ссылка.Магазин),
	|	ПРЕДСТАВЛЕНИЕ(Товары.Продавец),
	|	""В-"" + Товары.Ссылка.Номер,
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура),
	|	ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура.НоменклатурнаяГруппа),
	|	-Товары.Количество,
	|	-Товары.Сумма
	|ИЗ
	|	Документ.ЧекККМВозврат.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Дата МЕЖДУ &Начало И &Окончание
	|	И Товары.Ссылка.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Магазин,
	|	Чек";

	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);

	Статусы = Новый Массив;
	// ПРОВЕРИТЬ значения перечисления СтатусыЧековККМ.
	// После закрытия смены («Отчет о розничных продажах») чеки становятся «Архивный».
	Статусы.Добавить(Перечисления.СтатусыЧековККМ.Архивный);
	Если Не ТолькоЗакрытыеСмены Тогда
		Статусы.Добавить(Перечисления.СтатусыЧековККМ.Пробит);
	КонецЕсли;
	Запрос.УстановитьПараметр("Статусы", Статусы);

	// ВАРИАНТ Б (если в вашей базе продавец есть только в регистре продаж) — замените текст запроса:
	// ВЫБРАТЬ НАЧАЛОПЕРИОДА(Продажи.Период, ДЕНЬ) КАК Дата, ПРЕДСТАВЛЕНИЕ(Продажи.Магазин) КАК Магазин,
	//   ПРЕДСТАВЛЕНИЕ(Продажи.Продавец) КАК Продавец, ПРЕДСТАВЛЕНИЕ(Продажи.ДокументПродажи) КАК Чек,
	//   ПРЕДСТАВЛЕНИЕ(Продажи.Номенклатура) КАК Номенклатура,
	//   ПРЕДСТАВЛЕНИЕ(Продажи.Номенклатура.НоменклатурнаяГруппа) КАК Группа,
	//   Продажи.Количество КАК Количество, Продажи.Стоимость КАК Сумма   // ПРОВЕРИТЬ имя ресурса суммы со скидкой
	// ИЗ РегистрНакопления.Продажи КАК Продажи ГДЕ Продажи.Период МЕЖДУ &Начало И &Окончание

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ЗаписатьCSV(Таблица, ПолноеИмя)

	Запись = Новый ЗаписьТекста(ПолноеИмя, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("Дата;Магазин;Продавец;Чек;Номенклатура;Номенклатурная группа;Количество;Сумма");
	Для Каждого Стр Из Таблица Цикл
		Запись.ЗаписатьСтроку(
			Формат(Стр.Дата, "ДФ=dd.MM.yyyy") + ";"
			+ Очистить(Стр.Магазин) + ";"
			+ Очистить(Стр.Продавец) + ";"
			+ Очистить(Стр.Чек) + ";"
			+ Очистить(Стр.Номенклатура) + ";"
			+ Очистить(Стр.Группа) + ";"
			+ Формат(Стр.Количество, "ЧРД=.; ЧГ=0; ЧН=0") + ";"
			+ Формат(Стр.Сумма, "ЧРД=.; ЧГ=0; ЧН=0"));
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

Функция Очистить(Значение)
	Возврат СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Значение)), ";", ","), Символы.ПС, " ");
КонецФункции

Функция ДобавитьРазделитель(Каталог)
	Разделитель = ПолучитьРазделительПути();
	Если Прав(Каталог, 1) = Разделитель Тогда
		Возврат Каталог;
	КонецЕсли;
	Возврат Каталог + Разделитель;
КонецФункции

Процедура ОтправитьНаСервис(ПолноеИмя, ИмяФайла, АдресСервиса, ТокенСервиса)

	// АдресСервиса: http://192.168.1.10:8080/api/upload
	СтруктураURI = РазобратьАдрес(АдресСервиса);
	Соединение = Новый HTTPСоединение(СтруктураURI.Хост, СтруктураURI.Порт, , , , 60);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", ТокенСервиса);
	Заголовки.Вставить("X-Filename", КодироватьСтроку(ИмяФайла, СпособКодированияСтроки.КодировкаURL));
	Заголовки.Вставить("Content-Type", "text/csv; charset=utf-8");
	Запрос = Новый HTTPЗапрос(СтруктураURI.Путь, Заголовки);
	Запрос.УстановитьИмяФайлаТела(ПолноеИмя);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Бот не принял выгрузку: " + Ответ.КодСостояния + " " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;

КонецПроцедуры

Функция РазобратьАдрес(Адрес)
	Результат = Новый Структура("Хост, Порт, Путь", "", 80, "/");
	Остаток = СтрЗаменить(Адрес, "http://", "");
	Поз = СтрНайти(Остаток, "/");
	ХостПорт = ?(Поз > 0, Лев(Остаток, Поз - 1), Остаток);
	Результат.Путь = ?(Поз > 0, Сред(Остаток, Поз), "/");
	ПозДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозДвоеточия > 0 Тогда
		Результат.Хост = Лев(ХостПорт, ПозДвоеточия - 1);
		Результат.Порт = Число(Сред(ХостПорт, ПозДвоеточия + 1));
	Иначе
		Результат.Хост = ХостПорт;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ДополнительнаяОбработкаБСП

// Регистрация в «Дополнительные отчеты и обработки» (БСП) с возможностью регламентного запуска.
// ПРОВЕРИТЬ: в конфигурации есть подсистема «Дополнительные отчеты и обработки» (есть в Рознице 2.x/3.x).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Наименование = "Выгрузка продаж для бота продавцов";
	ПараметрыРегистрации.Информация = "Выгружает строки чеков за вчера и позавчера в папку/сервис awer-sales-bot.";
	ПараметрыРегистрации.БезопасныйРежим = Ложь; // нужна запись в файл и HTTP

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Выгрузить продажи за вчера";
	Команда.Идентификатор = "ВыгрузкаЗаВчера";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;

	Возврат ПараметрыРегистрации;

КонецФункции

// Вызывается БСП по команде и по расписанию (регламентное задание настраивается в карточке обработки).
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполнения) Экспорт

	Если ИдентификаторКоманды = "ВыгрузкаЗаВчера" Тогда
		// ПРОВЕРИТЬ/ЗАДАТЬ: папка входящих бота и (необязательно) адрес сервиса.
		ВыгрузитьЗаПоследниеДни(КаталогПоУмолчанию(), АдресПоУмолчанию(), ТокенПоУмолчанию(), 2);
	КонецЕсли;

КонецПроцедуры

Функция КаталогПоУмолчанию()
	Возврат "C:\awer-sales-bot\data\inbox"; // ЗАМЕНИТЬ на свою папку (или \\сервер\inbox)
КонецФункции

Функция АдресПоУмолчанию()
	Возврат ""; // например "http://192.168.1.10:8080/api/upload", если бот на другом компьютере
КонецФункции

Функция ТокенПоУмолчанию()
	Возврат ""; // UPLOAD_TOKEN из .env бота
КонецФункции

#КонецОбласти
