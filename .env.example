DATABASE_URL=postgresql://sync_user:sync_password@localhost:5432/sync_admin
SESSION_SECRET=сгенерировать-случайную-строку-минимум-32-символа
SECRETS_ENCRYPTION_KEY=сгенерировать-через-Fernet.generate_key

# Отдавать сессионную cookie только по HTTPS (флаг Secure). В проде за SSL — 1.
# Если сервер временно на голом HTTP (SSL ещё не выпущен) — 0, иначе вход не
# будет работать (браузер не пошлёт cookie по http).
SESSION_COOKIE_SECURE=1

# Склады на площадках, куда пишутся остатки (app/workers/scheduler.py)
WAREHOUSE_ID_WB=
WAREHOUSE_ID_OZON=
WAREHOUSE_ID_KIT=

# Канал обмена с 1С — ЛОКАЛЬНАЯ ПАПКА (без FTP; 1С и приложение на одной машине).
# Каталоги должны совпадать с ПараметрыОбмена() в обработке ОбменССайтом.epf.
# По умолчанию (если не задать) — C:\sync\tasks|results|archive.
SYNC_DIR_TASKS=C:\sync\tasks
SYNC_DIR_RESULTS=C:\sync\results
SYNC_DIR_ARCHIVE=C:\sync\archive
