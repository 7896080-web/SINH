DATABASE_URL=postgresql://sync_user:sync_password@localhost:5432/sync_admin
SESSION_SECRET=сгенерировать-случайную-строку-минимум-32-символа
SECRETS_ENCRYPTION_KEY=сгенерировать-через-Fernet.generate_key

# Отдавать сессионную cookie только по HTTPS (флаг Secure). В проде за SSL — 1.
# Если сервер временно на голом HTTP (SSL ещё не выпущен) — 0, иначе вход не
# будет работать (браузер не пошлёт cookie по http).
SESSION_COOKIE_SECURE=1

# Склады на площадках, куда пишутся остатки (app/workers/scheduler.py)
WAREHOUSE_ID_WB=
WAREHOUSE_ID_OZON=
WAREHOUSE_ID_KIT=

# Канал обмена с 1С — ЛОКАЛЬНАЯ ПАПКА (без FTP; 1С и приложение на одной машине).
# Каталоги должны совпадать с ПараметрыОбмена() в обработке ОбменССайтом.epf.
# По умолчанию (если не задать) — C:\sync\tasks|results|archive.
SYNC_DIR_TASKS=C:\sync\tasks
SYNC_DIR_RESULTS=C:\sync\results
SYNC_DIR_ARCHIVE=C:\sync\archive

# --- Уведомления наружу -------------------------------------------------
# Пока здесь пусто, система НИКОГО НЕ ПОЗОВЁТ: о том, что она встала или
# разошлась с реальностью, узнает только тот, кто откроет «Диагностику».
# Достаточно одного канала; заполнены оба — уйдёт по обоим.
# Подробности и как получить chat_id — deploy/README_WINDOWS.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=   # если отправитель отличается от ALERT_SMTP_USER
# ALERT_SMTP_TLS=0    # снять шифрование (по умолчанию включено)

# Через сколько напомнить о ТОЙ ЖЕ, никуда не девшейся поломке.
ALERT_REPEAT_HOURS=6
# Адрес для ссылки в сообщении. Веб слушает 127.0.0.1 — если перед ним стоит
# прокси, укажите адрес, по которому система открывается на самом деле.
ALERT_BASE_URL=http://127.0.0.1:8000

# Внешний сторож («мёртвый человек»). Всё, что выше, живёт ВНУТРИ воркера:
# умер воркер — умерли и уведомления. Сюда воркер раз в пять минут говорит
# «я жив», а о молчании пишет человеку внешний сервис (healthchecks.io и
# подобные). Это единственное, что переживает падение самого воркера.
ALERT_HEARTBEAT_URL=

# --- Вторая площадка для копий базы -------------------------------------
# Копии лежат на том же диске, что и база: отказ диска унесёт и её, и все
# копии разом. Укажите папку синхронизации облака (Яндекс.Диск и подобные),
# сетевую шару или второй физический диск — и проверенная копия будет
# уезжать туда после каждого бэкапа. Пусто — зеркала нет.
# ВАЖНО: .env с ключом шифрования в то же облако класть НЕЛЬЗЯ — иначе одна
# утечка даёт и базу, и доступ к кабинетам площадок.
BACKUP_MIRROR_DIR=
BACKUP_MIRROR_KEEP_DAILY=30
BACKUP_MIRROR_KEEP_WEEKLY=12
