////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка "ОбменССайтом" — FTP-обмен с админкой синхронизации остатков.
// Протокол файлов — см. 1c/README.md. Кодировка UTF-8, разделитель полей "|".
// Публикация файлов атомарная: пишем "имя.part", затем переименовываем в "имя".
//
// Точка входа — ВыполнитьОбмен(). Вызывать по расписанию (регламентное задание,
// например раз в минуту) и/или по кнопке формы.
//
// Места, зависящие от вашей конфигурации, помечены "// НАСТРОИТЬ:".
////////////////////////////////////////////////////////////////////////////////

#Область ПараметрыИПодключение

// Параметры обмена. НАСТРОИТЬ: логин/пароль и пути к каталогам.
// Пароль на боевой базе храните в защищённой константе/реквизите, не в коде.
Функция ПараметрыОбмена()
	Пар = Новый Структура;
	Пар.Вставить("Сервер", "136.243.92.95");
	Пар.Вставить("Порт", 21);
	Пар.Вставить("Пользователь", "");            // НАСТРОИТЬ
	Пар.Вставить("Пароль", "");                  // НАСТРОИТЬ
	Пар.Вставить("Пассивный", Истина);           // для IIS FTP обычно пассивный режим
	Пар.Вставить("КаталогTasks", "/sync/tasks");     // НАСТРОИТЬ путь каталога обмена
	Пар.Вставить("КаталогResults", "/sync/results"); // НАСТРОИТЬ
	Пар.Вставить("КаталогArchive", "/sync/archive"); // НАСТРОИТЬ
	// Имена складов — должны совпадать с приложением и с командами в заданиях.
	Пар.Вставить("СкладЦС", "ЦС");
	Возврат Пар;
КонецФункции

Функция ПодключитьсяFTP(Пар)
	Соединение = Новый FTPСоединение(Пар.Сервер, Пар.Порт, Пар.Пользователь, Пар.Пароль, , Пар.Пассивный, 30);
	Возврат Соединение;
КонецФункции

#КонецОбласти

#Область ГлавнаяПроцедура

// Главная процедура обмена: разобрать все задания из каталога tasks.
Процедура ВыполнитьОбмен() Экспорт
	Пар = ПараметрыОбмена();
	Соединение = ПодключитьсяFTP(Пар);

	ФайлыЗаданий = Соединение.НайтиФайлы(Пар.КаталогTasks, "task_*.txt");
	Для Каждого ФайлЗадания Из ФайлыЗаданий Цикл
		Попытка
			ОбработатьФайлЗадания(Соединение, Пар, ФайлЗадания);
		Исключение
			// Не роняем весь цикл из-за одного файла — логируем и идём дальше.
			ЗаписьЖурналаРегистрации("ОбменССайтом", УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка обработки " + ФайлЗадания.Имя + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Обработать один файл-задание: выполнить команды, записать результаты и/или
// выгрузку остатков, перенести файл в архив.
Процедура ОбработатьФайлЗадания(Соединение, Пар, ФайлЗадания)
	ЛокальныйФайл = ПолучитьИмяВременногоФайла("txt");
	Соединение.Получить(ФайлЗадания.ПолноеИмя, ЛокальныйФайл);
	Содержимое = ПрочитатьТекстФайла(ЛокальныйФайл);

	Метка = Формат(ТекущаяДата(), "ДФ=ггггММддЧЧммсс");
	СтрокиРезультата = Новый Массив;
	НужнаВыгрузкаОстатков = Ложь;

	Для Каждого Строка Из РазбитьНаСтроки(Содержимое) Цикл
		Строка = СокрЛП(Строка);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Поля = РазложитьСтроку(Строка, "|");
		Команда = Поля[0];

		Если Команда = "EXPORT_STOCK_ON_HAND" Тогда
			НужнаВыгрузкаОстатков = Истина;

		ИначеЕсли Команда = "CREATE_MOVEMENT" ИЛИ Команда = "CONFIRM_MOVEMENT" Тогда
			// Поля: 0=команда 1=баркод 2=склад_откуда 3=склад_куда 4=кол-во 5=order_id 6=площадка
			ИдЗаказа = Поля[5];
			Попытка
				НомерДок = ВыполнитьПеремещение(Команда, Поля[1], Поля[2], Поля[3], Число(Поля[4]), ИдЗаказа, Поля[6]);
				СтрокиРезультата.Добавить(ИдЗаказа + "|OK|" + НомерДок);
			Исключение
				СтрокиРезультата.Добавить(ИдЗаказа + "|ERROR|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

		ИначеЕсли Команда = "CANCEL_MOVEMENT" Тогда
			// Поля: 0=команда 1=order_id 2=площадка
			ИдЗаказа = Поля[1];
			Попытка
				НомерДок = ОтменитьПеремещенияЗаказа(ИдЗаказа);
				СтрокиРезультата.Добавить(ИдЗаказа + "|OK|" + НомерДок);
			Исключение
				СтрокиРезультата.Добавить(ИдЗаказа + "|ERROR|" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Если СтрокиРезультата.Количество() > 0 Тогда
		ОпубликоватьФайл(Соединение, Пар.КаталогResults, "result_" + Метка + ".txt", СоединитьСтроки(СтрокиРезультата));
	КонецЕсли;

	Если НужнаВыгрузкаОстатков Тогда
		ОпубликоватьФайл(Соединение, Пар.КаталогResults, "stock_" + Метка + ".txt", ВыгрузитьОстаткиЦС(Пар));
	КонецЕсли;

	// Файл задания — в архив; локальную копию удаляем.
	Соединение.Переместить(ФайлЗадания.ПолноеИмя, СоединитьПуть(Пар.КаталогArchive, ФайлЗадания.Имя));
	УдалитьФайлы(ЛокальныйФайл);
КонецПроцедуры

#КонецОбласти

#Область БизнесОперации_НАСТРОИТЬ

// НАСТРОИТЬ: создание/проведение документа перемещения.
// Команда = "CREATE_MOVEMENT" (резерв, ЦС->Ожидает) или "CONFIRM_MOVEMENT"
// (подтверждение, Ожидает->Склад площадки). Разницы в логике нет — просто
// перемещение между переданными складами; тип команды на будущее.
// order_id обязательно сохранить в документе (реквизит/комментарий) — по нему
// работает ОтменитьПеремещенияЗаказа().
// Возвращает представление документа (номер) для файла результата.
Функция ВыполнитьПеремещение(Команда, Баркод, ИмяСкладаОткуда, ИмяСкладаКуда, Количество, ИдЗаказа, Площадка)
	СведенияОТоваре = НайтиНоменклатуруПоШтрихкоду(Баркод);
	Если СведенияОТоваре = Неопределено Тогда
		ВызватьИсключение "Не найдена номенклатура по штрихкоду " + Баркод;
	КонецЕсли;
	СкладОткуда = НайтиСклад(ИмяСкладаОткуда);
	СкладКуда   = НайтиСклад(ИмяСкладаКуда);

	// НАСТРОИТЬ: тип документа перемещения вашей конфигурации.
	Документ = Документы.ПеремещениеТоваров.СоздатьДокумент();       // НАСТРОИТЬ: имя документа
	Документ.Дата = ТекущаяДата();
	Документ.СкладОтправитель = СкладОткуда;                         // НАСТРОИТЬ: имена реквизитов
	Документ.СкладПолучатель  = СкладКуда;
	Документ.Комментарий = "sync order_id=" + ИдЗаказа + " " + Площадка; // order_id для отмены
	Строка = Документ.Товары.Добавить();                            // НАСТРОИТЬ: имя табличной части
	Строка.Номенклатура = СведенияОТоваре.Номенклатура;
	Строка.Характеристика = СведенияОТоваре.Характеристика;         // если ведётся учёт по характеристикам
	Строка.Количество = Количество;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

	Возврат Строка(Документ.Номер);
КонецФункции

// НАСТРОИТЬ: отмена/возврат — реверс движений заказа обратно на ЦС.
// Находим ранее созданные документы по order_id (сохранённому в Комментарии/
// реквизите) и создаём обратное перемещение или сторно.
Функция ОтменитьПеремещенияЗаказа(ИдЗаказа)
	// НАСТРОИТЬ пример: найти документы перемещения по подстроке order_id.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Ссылка ИЗ Документ.ПеремещениеТоваров
		|ГДЕ Комментарий ПОДОБНО &Шаблон И Проведен = ИСТИНА";   // НАСТРОИТЬ
	Запрос.УстановитьПараметр("Шаблон", "%order_id=" + ИдЗаказа + " %");
	Выборка = Запрос.Выполнить().Выбрать();

	НомераОбратных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Исходный = Выборка.Ссылка.ПолучитьОбъект();
		// Обратное перемещение: меняем склады местами.
		Обратный = Документы.ПеремещениеТоваров.СоздатьДокумент();  // НАСТРОИТЬ
		Обратный.Дата = ТекущаяДата();
		Обратный.СкладОтправитель = Исходный.СкладПолучатель;
		Обратный.СкладПолучатель  = НайтиСклад(ПараметрыОбмена().СкладЦС); // возврат на ЦС
		Обратный.Комментарий = "sync REVERSE " + Исходный.Комментарий;
		Для Каждого СтрокаТовара Из Исходный.Товары Цикл
			НоваяСтрока = Обратный.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
		КонецЦикла;
		Обратный.Записать(РежимЗаписиДокумента.Проведение);
		НомераОбратных.Добавить(Строка(Обратный.Номер));
	КонецЦикла;

	Если НомераОбратных.Количество() = 0 Тогда
		Возврат "нет документов для отмены";
	КонецЕсли;
	Возврат СтрСоединить(НомераОбратных, ",");
КонецФункции

// НАСТРОИТЬ: выгрузка остатков склада ЦС в формат приложения.
// Строка: uid_1c|артикул|наименование|количество|баркод1,баркод2
// uid_1c — идентификатор размер-цвет SKU (номенклатура+характеристика);
// он же ключ в приложении (Product.uid_1c). Количество может быть отрицательным.
Функция ВыгрузитьОстаткиЦС(Пар)
	Запрос = Новый Запрос;
	// НАСТРОИТЬ: имя регистра остатков (ТоварыНаСкладах/ОстаткиТоваров и т.п.)
	// и имя ресурса количества.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	Остатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК Остатки"; // НАСТРОИТЬ
	Запрос.УстановитьПараметр("Склад", НайтиСклад(Пар.СкладЦС));
	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Уид = ИдентификаторSKU(Выборка.Номенклатура, Выборка.Характеристика); // НАСТРОИТЬ
		Артикул = "" + Выборка.Номенклатура.Артикул;                          // НАСТРОИТЬ имя реквизита
		Наименование = "" + Выборка.Номенклатура.Наименование;
		Кол = Формат(Выборка.Количество, "ЧГ=0; ЧН=-; ЧДЦ=0");
		Баркоды = БаркодыSKU(Выборка.Номенклатура, Выборка.Характеристика);   // НАСТРОИТЬ "bc1,bc2"
		Если ПустаяСтрока(Баркоды) Тогда
			Продолжить; // без баркода позицию не выгружаем — приложению нечем сопоставить
		КонецЕсли;
		Строки.Добавить(Уид + "|" + Артикул + "|" + Наименование + "|" + Кол + "|" + Баркоды);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// НАСТРОИТЬ: поиск номенклатуры (и характеристики) по штрихкоду.
// Вернуть Структуру с полями Номенклатура, Характеристика — или Неопределено.
Функция НайтиНоменклатуруПоШтрихкоду(Баркод)
	Запрос = Новый Запрос;
	// НАСТРОИТЬ: имя регистра штрихкодов вашей конфигурации.
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура, Характеристика
		|ИЗ РегистрСведений.ШтрихкодыНоменклатуры
		|ГДЕ Штрихкод = &Штрихкод";                                  // НАСТРОИТЬ
	Запрос.УстановитьПараметр("Штрихкод", Баркод);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Рез = Новый Структура("Номенклатура, Характеристика");
	Рез.Номенклатура = Выборка.Номенклатура;
	Рез.Характеристика = Выборка.Характеристика;
	Возврат Рез;
КонецФункции

// НАСТРОИТЬ: идентификатор размер-цвет SKU для приложения (Product.uid_1c).
// Если учёт по характеристикам — берём идентификатор характеристики; если нет —
// идентификатор номенклатуры. Главное: стабильный и уникальный на размер-цвет.
Функция ИдентификаторSKU(Номенклатура, Характеристика)
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Возврат Строка(Характеристика.УникальныйИдентификатор());
	КонецЕсли;
	Возврат Строка(Номенклатура.УникальныйИдентификатор());
КонецФункции

// НАСТРОИТЬ: все баркоды размер-цвета через запятую.
Функция БаркодыSKU(Номенклатура, Характеристика)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Штрихкод ИЗ РегистрСведений.ШтрихкодыНоменклатуры
		|ГДЕ Номенклатура = &Номенклатура И Характеристика = &Характеристика"; // НАСТРОИТЬ
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Не ПустаяСтрока(Выборка.Штрихкод) Тогда
			Список.Добавить(СокрЛП(Выборка.Штрихкод));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Список, ",");
КонецФункции

// Поиск склада по наименованию. НАСТРОИТЬ, если склады — не справочник Склады.
Функция НайтиСклад(Имя)
	Склад = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);   // НАСТРОИТЬ
	Если Склад = Неопределено ИЛИ Склад.Пустая() Тогда
		ВызватьИсключение "Не найден склад «" + Имя + "» — заведите его в 1С с точным именем.";
	КонецЕсли;
	Возврат Склад;
КонецФункции

#КонецОбласти

#Область СлужебныеФункции

// Атомарная публикация файла на FTP: локальный текст -> "имя.part" -> "имя".
Процедура ОпубликоватьФайл(Соединение, КаталогНаСервере, ИмяФайла, Текст)
	Локальный = ПолучитьИмяВременногоФайла("txt");
	ЗаписатьТекстФайла(Локальный, Текст);
	ПутьЧастичный = СоединитьПуть(КаталогНаСервере, ИмяФайла + ".part");
	ПутьИтоговый  = СоединитьПуть(КаталогНаСервере, ИмяФайла);
	Соединение.Записать(Локальный, ПутьЧастичный);
	Соединение.Переместить(ПутьЧастичный, ПутьИтоговый);
	УдалитьФайлы(Локальный);
КонецПроцедуры

Функция ПрочитатьТекстФайла(Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Содержимое = Неопределено, "", Содержимое);
КонецФункции

Процедура ЗаписатьТекстФайла(Путь, Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция РазбитьНаСтроки(Текст)
	Возврат СтрРазделить(Текст, Символы.ПС + Символы.ВК, Истина);
КонецФункции

Функция РазложитьСтроку(Строка, Разделитель)
	Возврат СтрРазделить(Строка, Разделитель, Истина);
КонецФункции

Функция СоединитьСтроки(Массив)
	Возврат СтрСоединить(Массив, Символы.ПС);
КонецФункции

Функция СоединитьПуть(Каталог, Имя)
	Если Прав(Каталог, 1) = "/" Тогда
		Возврат Каталог + Имя;
	КонецЕсли;
	Возврат Каталог + "/" + Имя;
КонецФункции

#КонецОбласти
