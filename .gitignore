# Секреты — никогда не коммитить
.env
*.pem
*.key

# Виртуальное окружение
venv/
.venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Локальные базы данных для разработки/тестов
*.db
*.db-journal
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/

# ОС
.DS_Store

# Бэкапы (создаются deploy/backup.sh на сервере, не в репозитории)
/backups/

# Отметку «какая версия наката тут лежит» пишет сам apply-скрипт на СЕРВЕРЕ.
# В репозитории её быть не должно: она про конкретную машину, а не про код.
deploy/INSTALLED_TAG

# Патчи наката на боевой сервер. Порождаемый артефакт, а не исходник:
# собираются из `scripts/gen_whole_file_patch.py` по тегу и содержат те же
# файлы, что и коммит рядом, — только в base64. В истории их нет ни одного.
pm*_deploy.ps1
pm*_apply.py
pm*.b64
